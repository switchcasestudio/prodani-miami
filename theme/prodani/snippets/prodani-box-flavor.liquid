{%- comment -%}
  Box builder: which cake a flavor row is, worked out from its name, so the row can show
  the same cut-out and tint as the rest of the site without anyone uploading an image.
  Output: "key|cutout|tint|ink|width|height", or nothing for a name it does not know.
  The keys match field 6 of prodani-flavor-map.
{%- endcomment -%}
{%- liquid
  assign nm = name | downcase
  if nm contains 'hazelnut'
    echo 'hazelnut|pd-cut-hazelnut.webp|#F6E1C8|#9A5F2C|358|924'
  elsif nm contains 'pistachio' or nm contains 'dubai'
    echo 'pistachio|pd-cut-pistachio.webp|#EBEFCB|#5F7230|388|950'
  elsif nm contains 'cherry'
    echo 'cherry|pd-cut-cherry-white.webp|#FBE4E9|#C13A5A|368|950'
  elsif nm contains 'carrot'
    echo 'carrot|pd-cut-carrot.webp|#FBE2C9|#B9560F|358|922'
  elsif nm contains 'banana'
    echo 'banana|pd-cut-banana.webp|#FBEEC2|#8F6A0E|375|954'
  elsif nm contains 'apple'
    echo 'apple|pd-cut-apple.webp|#F6E4CC|#94602C|369|945'
  elsif nm contains 'chocolate' or nm contains 'ganache'
    echo 'chocolate|pd-cut-chocolate.webp|#EAD5C8|#5B3A2E|374|953'
  endif
-%}
