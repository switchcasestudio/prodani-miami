{%- comment -%}
  Above-the-fold taste line, macro strip, and claim badges. Metafield-driven
  (namespace `prodani` — see theme/METAFIELDS.md). This snippet renders once and
  loads the PDP stylesheet for the whole page.

  Go-live rule (2026-10-08): nothing sampled reaches shoppers. A missing value shows
  its flagged SAMPLE only inside the theme editor (request.design_mode); on the
  storefront the line or chip is simply left out. No fallbacks: the real labels
  (entered 2026-10-08) range 15–20g protein, so a blanket "20g" would be wrong for
  some cakes. A product with no values shows no macro strip at all.

  Badges: NEVER sampled. Each badge is a nutrition/ingredient claim, so a badge only
  appears when the matching boolean metafield is explicitly true in admin (ticket T2).
{%- endcomment -%}
{{ 'prodani-pdp.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign mf = product.metafields.prodani
  assign protein = mf.protein_g.value
  assign calories = mf.calories.value
  assign sugar = mf.sugar_g.value
  assign taste = mf.taste.value
-%}

{%- liquid
  assign edit = request.design_mode
  assign has_any = false
  if protein != blank or calories != blank or sugar != blank
    assign has_any = true
  endif
-%}

{%- if taste != blank -%}
  <p class="pd-taste">{{ taste }}</p>
{%- elsif edit -%}
  <p class="pd-taste is-sample">A sample flavor description — set <code>prodani.taste</code> in admin.</p>
{%- endif -%}

{%- if has_any or edit -%}
<div class="pd-macros" role="list" aria-label="Nutrition per serving">
  {%- if protein != blank or edit -%}
    <div class="pd-macro{% if protein == blank %} is-sample{% endif %}" role="listitem">
      {%- if protein == blank %}<span class="pd-sample-flag">sample</span>{% endif -%}
      <span class="pd-macro__n">{{ protein | default: 20 }}g</span>
      <span class="pd-macro__l">Protein</span>
    </div>
  {%- endif -%}
  {%- if calories != blank or edit -%}
    <div class="pd-macro{% if calories == blank %} is-sample{% endif %}" role="listitem">
      {%- if calories == blank %}<span class="pd-sample-flag">sample</span>{% endif -%}
      <span class="pd-macro__n">{{ calories | default: 180 }}</span>
      <span class="pd-macro__l">Calories</span>
    </div>
  {%- endif -%}
  {%- comment -%}
    Audit fix (2026-11-10): beside a "No sugar added" tag, a "4g sugar" cell reads as a
    contradiction. When the no_sugar_added claim is explicitly true the cell states the
    claim itself (0g added sugar); the total sugar stays in the nutrition table.
  {%- endcomment -%}
  {%- if mf.no_sugar_added.value == true -%}
    <div class="pd-macro" role="listitem">
      <span class="pd-macro__n">0g</span>
      <span class="pd-macro__l">Added sugar</span>
    </div>
  {%- elsif sugar != blank or edit -%}
    <div class="pd-macro{% if sugar == blank %} is-sample{% endif %}" role="listitem">
      {%- if sugar == blank %}<span class="pd-sample-flag">sample</span>{% endif -%}
      <span class="pd-macro__n">{{ sugar | default: 2 }}g</span>
      <span class="pd-macro__l">Sugar</span>
    </div>
  {%- endif -%}
  {%- if mf.gluten_free.value -%}
    <div class="pd-macro" role="listitem">
      <span class="pd-macro__n">GF</span>
      <span class="pd-macro__l">Gluten free</span>
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{%- comment -%}
  Macro Bold (2026-11-10): the claim badges are set as square caps tags above the
  title (CSS order) instead of round icons. Same rule: a tag only when its boolean is
  explicitly true. The first approved claim gets the pink fill.
{%- endcomment -%}
{%- liquid
  assign claims = ''
  if mf.high_protein.value
    assign claims = claims | append: 'High protein|'
  endif
  comment
    Gluten free already has its own cell in the macro row when that row shows.
  endcomment
  if mf.gluten_free.value and has_any == false
    assign claims = claims | append: 'Gluten free|'
  endif
  if mf.no_sugar_added.value
    assign claims = claims | append: 'No sugar added|'
  endif
  if mf.non_gmo.value
    assign claims = claims | append: 'Non-GMO|'
  endif
  if mf.low_calorie.value
    assign claims = claims | append: 'Low calorie|'
  endif
  if mf.high_fiber.value
    assign claims = claims | append: 'High fiber|'
  endif
  assign claim_list = claims | split: '|'
-%}
{%- if claim_list.size > 0 -%}
<ul class="pd-badges" aria-label="Product claims">
  {%- for c in claim_list -%}
    <li class="pd-tag{% if forloop.first %} pd-tag--pink{% endif %}">{{ c }}</li>
  {%- endfor -%}
</ul>
{%- endif -%}
