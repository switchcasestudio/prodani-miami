{%- comment -%}
  PDP proof (brief §08 "Proof"): ingredients, allergens, storage/shelf life,
  shipping & returns, FAQ and the nutrition facts. Metafield-driven (namespace
  `prodani`). Go-live rule (2026-10-08): a part with no real content is left out on
  the storefront; its flagged sample shows only inside the theme editor.

  Macro Bold (2026-11-10): this used to be a stack of accordions inside the buy
  column. It is now a full-width band of ruled cells under the product frame plus a
  ruled nutrition table, rendered from sections/main-product.liquid with
  placement: 'below'. The `pd_info` custom-liquid block in templates/product.json
  still calls this snippet without a placement; that call renders nothing, so the
  block can stay without printing the content twice.

  Ingredients and allergens: the metafield wins; otherwise the "Ingredients:" and
  "Allergens:" paragraphs of the product description are used (see
  snippets/prodani-pdp-desc.liquid), which are then not repeated in the buy column.

  Nutrition: the rich-text metafield holds one fact per paragraph ("Total Fat 7g ·
  9%"). Each paragraph becomes a table row: name | amount | % daily value. Calories
  and Protein rows are highlighted. Nothing is computed or added; a paragraph that
  does not split cleanly is shown whole in the name column.
{%- endcomment -%}
{%- if placement == 'below' -%}
{{ 'prodani-pdp.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign mf = product.metafields.prodani
  assign edit = request.design_mode

  assign ingredients = mf.ingredients.value | default: ''
  if ingredients == ''
    capture ingredients
      render 'prodani-pdp-desc', part: 'ingredients'
    endcapture
    assign ingredients = ingredients | strip
  endif
  assign allergens = mf.allergens.value | default: ''
  if allergens == ''
    capture allergens
      render 'prodani-pdp-desc', part: 'allergens'
    endcapture
    assign allergens = allergens | strip
  endif

  assign has_storage = false
  if mf.storage != blank or mf.shelf_life != blank
    assign has_storage = true
  endif
  # Moses 2026-11-18: cakes keep 8 days in the fridge and 90 days in the freezer. Used
  # for any cake until the prodani.storage / shelf_life metafields say otherwise.
  assign cake_shelf = false
  if has_storage == false and product.type contains 'ake'
    assign cake_shelf = true
    assign has_storage = true
  endif
  assign has_ship = false
  if shop.shipping_policy.body != blank or shop.refund_policy.body != blank
    assign has_ship = true
  endif
-%}
<section class="pd-details" aria-label="Product details">
  <div class="pd-details__cells">

    {%- if ingredients != '' or edit -%}
      <div class="pd-details__cell pd-details__cell--wide">
        <h2 class="pd-details__h">What's in it</h2>
        {%- if ingredients != '' -%}
          <p>{{ ingredients | newline_to_br }}</p>
        {%- else -%}
          <p class="is-sample">Sample — the full ingredient list will appear here once
            <code>prodani.ingredients</code> is set in admin.</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if allergens != '' or edit -%}
      <div class="pd-details__cell">
        <h2 class="pd-details__h">Allergens</h2>
        {%- if allergens != '' -%}
          <p class="pd-details__warn">{{ allergens }}</p>
        {%- else -%}
          <p class="is-sample">Sample — allergen statement appears here once
            <code>prodani.allergens</code> is set in admin (ticket T2/T4).</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_storage or edit -%}
      <div class="pd-details__cell">
        <h2 class="pd-details__h">Storage &amp; shelf life</h2>
        {%- if has_storage -%}
          {%- if cake_shelf -%}
            <p><b>Fridge:</b> up to 8 days.<br><b>Freezer:</b> up to 90 days.</p>
          {%- endif -%}
          {%- if mf.storage != blank %}<p>{{ mf.storage.value }}</p>{% endif -%}
          {%- if mf.shelf_life != blank %}<p>{{ mf.shelf_life.value }}</p>{% endif -%}
        {%- else -%}
          <p class="is-sample">Sample — storage and shelf-life guidance appears here once set in
            admin. Whether items are refrigerated, frozen, or shelf-stable is pending (ticket T5).</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_ship or edit -%}
      <div class="pd-details__cell">
        <h2 class="pd-details__h">{% if shop.shipping_policy.body != blank %}Shipping &amp; returns{% else %}Returns{% endif %}</h2>
        <div class="pd-details__rte">
          {%- comment -%} Moses 2026-11-18: anyone with a problem is welcome to reach out and we
              make it right. The 24-hour window is the store's refund policy. {%- endcomment -%}
          <p>Something not right with your cakes? Write to us and we will make it right. Refunds and cancellations within 24 hours of ordering.</p>
          {%- if shop.shipping_policy.body != blank -%}
            {{ shop.shipping_policy.body }}
          {%- endif -%}
          {%- if shop.refund_policy.body != blank -%}
            <p><a class="pd-details__link" href="{{ shop.refund_policy.url }}">Read our full returns policy</a></p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if mf.faq != blank -%}
      <div class="pd-details__cell pd-details__cell--full">
        <h2 class="pd-details__h">FAQ</h2>
        <div class="pd-details__rte">{{ mf.faq | metafield_tag }}</div>
      </div>
    {%- endif -%}
  </div>

  {%- if mf.nutrition_facts != blank or edit -%}
    <div class="pd-nut">
      <div class="pd-nut__side">
        <p class="pd-eyebrow">Per serving</p>
        <h2 class="pd-nut__title">Nutrition facts</h2>
        {%- if mf.protein_source.value != blank -%}
          <p class="pd-nut__src">Protein source: {{ mf.protein_source.value }}</p>
        {%- endif -%}
        {%- comment -%} Audit fix (2026-11-10): the flavor cut-out (same as the gallery) fills the panel. {%- endcomment -%}
        {%- capture nut_fm -%}{% render 'prodani-flavor-map', handle: product.handle %}{%- endcapture -%}
        {%- assign nut_fl = nut_fm | strip | split: '|' -%}
        {%- if nut_fl[4] != blank -%}
          <img class="pd-nut__cut" src="{{ nut_fl[4] | asset_url }}" alt="" width="600" height="600" loading="lazy">
        {%- endif -%}
      </div>
      <div class="pd-nut__main">
        {%- if mf.nutrition_facts != blank -%}
          {%- capture nf_html -%}{{ mf.nutrition_facts | metafield_tag }}{%- endcapture -%}
          {%- assign nf_rows = nf_html | replace: '</li>', '</p>' | split: '</p>' -%}
          {%- assign nf_note = '' -%}
          <table class="pd-nut__table">
            <caption class="visually-hidden">Nutrition facts for {{ product.title | escape }}</caption>
            <thead class="visually-hidden"><tr><th scope="col">Nutrient</th><th scope="col">Amount</th><th scope="col">% Daily Value</th></tr></thead>
            <tbody>
            {%- for row in nf_rows -%}
              {%- liquid
                assign t = row | strip_html | strip
                if t == blank
                  continue
                endif
                assign first = t | slice: 0
                if first == '%' or first == '*'
                  assign nf_note = t
                  continue
                endif
                assign name = t
                assign amount = ''
                assign dv = ''
                if t contains ': '
                  assign bits = t | split: ': '
                  assign name = bits | first
                  assign amount = t | remove_first: name | remove_first: ': '
                else
                  if t contains ' · '
                    assign bits = t | split: ' · '
                    assign dv = bits | last
                    assign main = bits | first
                  else
                    assign main = t
                  endif
                  assign words = main | split: ' '
                  assign last_word = words | last
                  assign lead = last_word | slice: 0
                  if words.size > 1 and '0123456789' contains lead and lead != ''
                    assign amount = last_word
                    assign name = main | remove_last: last_word | strip
                  else
                    assign name = main
                  endif
                endif
                assign name_d = name | downcase
                assign cls = ''
                assign h8 = name_d | slice: 0, 8
                assign h7 = name_d | slice: 0, 7
                if h8 == 'calories' or h7 == 'protein'
                  assign cls = 'is-hl'
                endif
                assign subs = 'saturated,trans fat,polyunsaturated,monounsaturated,dietary fiber,total sugars,includes' | split: ','
                for s in subs
                  assign hs = name_d | slice: 0, s.size
                  if hs == s
                    assign cls = cls | append: ' is-sub'
                  endif
                endfor
              -%}
              <tr class="{{ cls | strip }}">
                <th scope="row">{{ name }}</th>
                <td class="pd-nut__amt">{{ amount }}</td>
                <td class="pd-nut__dv">{{ dv }}</td>
              </tr>
            {%- endfor -%}
            </tbody>
          </table>
          {%- if nf_note != '' -%}<p class="pd-nut__note">{{ nf_note }}</p>{%- endif -%}
        {%- else -%}
          <p class="is-sample">Sample — full nutrition facts per serving will appear here once
            <code>prodani.nutrition_facts</code> is set in admin (ticket T4). Protein source:
            {{ mf.protein_source.value | default: 'to be confirmed' }}.</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>
{%- endif -%}
