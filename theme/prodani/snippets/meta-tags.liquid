{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- comment -%}
  Share image per page (prodani). Commerce pages use their own photo; everything
  else uses the theme share image, then the homepage hero poster. Never empty.
{%- endcomment -%}
{%- liquid
  assign og_image = page_image
  assign og_image_alt = og_title
  case request.page_type
    when 'product'
      assign og_image = product.featured_image | default: page_image
      assign og_image_alt = product.featured_image.alt | default: product.title
    when 'collection'
      assign og_image = collection.image | default: collection.featured_image | default: collection.products.first.featured_image
      assign og_image_alt = collection.title
    when 'article'
      assign og_image = article.image | default: page_image
      assign og_image_alt = article.image.alt | default: article.title
    when 'blog'
      assign og_image = blog.articles.first.image | default: page_image
      assign og_image_alt = blog.title
  endcase
  if og_image == blank
    assign og_image = settings.share_image
    assign og_image_alt = og_image.alt | default: og_title
  endif

  # Small 1200x630 JPG cards (assets/og-<handle>.jpg) for the cakes: their photos are 1MB+ PNGs,
  # which WhatsApp won't preview, and Shopify's CDN won't convert PNG to JPG for crawlers.
  # Add a handle here when its og-<handle>.jpg asset is uploaded.
  assign og_cards = 'banana-bread-copy,carrot-cake,cinnamon-apple-cake-copy,dubai-dream-cake-copy,moist-chocolate-fudge-cake-copy,personal-chocolate-fudge-cake-copy,personal-hazelnuts-cake' | split: ','
  assign og_card_handle = ''
  if request.page_type == 'product'
    assign og_card_handle = product.handle
  elsif request.page_type == 'collection' and collection.image == blank
    assign og_card_handle = collection.products.first.handle
  endif
-%}

{%- if og_card_handle != blank and og_cards contains og_card_handle -%}
  {%- assign og_image_url = 'og-' | append: og_card_handle | append: '.jpg' | asset_url -%}
  <meta property="og:image" content="https:{{ og_image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:image" content="https:{{ og_image_url }}">
{%- elsif og_image != blank -%}
  {%- assign og_image_url = og_image | image_url: width: 1200 -%}
  {%- assign og_w = og_image.width | at_most: 1200 -%}
  {%- assign og_h = og_image.height | times: og_w | divided_by: og_image.width -%}
  <meta property="og:image" content="https:{{ og_image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image_url }}">
  <meta property="og:image:width" content="{{ og_w }}">
  <meta property="og:image:height" content="{{ og_h }}">
  <meta name="twitter:image" content="https:{{ og_image_url }}">
{%- else -%}
  {%- assign og_image_url = 'hero-poster.jpg' | asset_url -%}
  <meta property="og:image" content="https:{{ og_image_url }}">
  <meta property="og:image:secure_url" content="https:{{ og_image_url }}">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta name="twitter:image" content="https:{{ og_image_url }}">
  {%- assign og_image_alt = 'A prodani protein chocolate cake on a white plate' -%}
{%- endif -%}
<meta property="og:image:alt" content="{{ og_image_alt | escape }}">
<meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
