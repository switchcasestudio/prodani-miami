{%- comment -%}
  Breadcrumbs + BreadcrumbList JSON-LD (prodani).
  Product:    Home › Shop › [collection it was reached from, else Personal Cakes] › Product
  Collection: Home › Shop › Collection   (the all-products views stop at Shop)
  Article:    Home › Blog › Article
  Rendered from main-product, prodani-shop (collection pages only) and main-article.
{%- endcomment -%}
{%- liquid
  assign shop_url = routes.all_products_collection_url
  assign mid_title = blank
  assign mid_url = blank
  assign last_title = blank
  assign shop_is_last = false

  case request.page_type
    when 'product'
      assign crumb_collection = collection
      if crumb_collection == blank or crumb_collection.handle == 'all' or crumb_collection.handle == 'all-products'
        assign crumb_collection = blank
        for c in product.collections
          if c.handle == 'personal-protein-cakes'
            assign crumb_collection = c
          endif
        endfor
      endif
      if crumb_collection != blank
        assign mid_title = crumb_collection.title
        assign mid_url = crumb_collection.url
      endif
      assign last_title = product.title
    when 'collection'
      if collection.handle == 'all' or collection.handle == 'all-products'
        assign shop_is_last = true
      else
        assign last_title = collection.title
      endif
    when 'article'
      assign shop_url = blog.url
      assign last_title = article.title
  endcase

  assign shop_label = 'Shop'
  if request.page_type == 'article'
    assign shop_label = blog.title
  endif
-%}
{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'article' -%}
  {{ 'prodani-breadcrumbs.css' | asset_url | stylesheet_tag }}
  <nav class="pd-crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if shop_is_last -%}
        <li><span aria-current="page">{{ shop_label | escape }}</span></li>
      {%- else -%}
        <li><a href="{{ shop_url }}">{{ shop_label | escape }}</a></li>
        {%- if mid_title != blank -%}
          <li><a href="{{ mid_url }}">{{ mid_title | escape }}</a></li>
        {%- endif -%}
        <li><span aria-current="page">{{ last_title | escape }}</span></li>
      {%- endif -%}
    </ol>
  </nav>
  {%- capture crumb_base -%}{{ request.origin }}{%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ crumb_base | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ shop_label | json }}, "item": {{ crumb_base | append: shop_url | json }} }
        {%- unless shop_is_last -%}
          {%- if mid_title != blank -%}
            ,{ "@type": "ListItem", "position": 3, "name": {{ mid_title | json }}, "item": {{ crumb_base | append: mid_url | json }} }
            ,{ "@type": "ListItem", "position": 4, "name": {{ last_title | json }}, "item": {{ canonical_url | json }} }
          {%- else -%}
            ,{ "@type": "ListItem", "position": 3, "name": {{ last_title | json }}, "item": {{ canonical_url | json }} }
          {%- endif -%}
        {%- endunless -%}
      ]
    }
  </script>
{%- endif -%}
