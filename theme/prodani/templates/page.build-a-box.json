    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How does Build Your Box work?",
            "row_content": "<p>Pick a box size (6, 12 or 18 cakes), then choose how many of each flavor you want. Mix and match however you like; the box just has to add up to the size you picked. Prefer not to choose? Start from a curated box like Best Sellers or Variety and adjust it from there.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I mix different flavors in one box?",
            "row_content": "<p>Yes, that's the point. Every box is mix and match across the full flavor lineup, in whatever combination you want.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do subscriptions work?",
            "row_content": "<p>Choose Subscribe &amp; save at checkout and pick how often you'd like a box. You can skip a delivery, pause, change your flavors or cancel at any time from your account. No phone call, no email required.</p>"
          }
        }
      },
