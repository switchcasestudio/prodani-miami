{%- comment -%}
  The spreads on the homepage: the "Meet the trio" cards from the spreads page
  (sections/prodani-spreads.liquid), without a photo (Moses 2026-11-18: the open-box
  photo goes; "I love this so much more").
  Each card has an optional photo. It stays empty until there is a real photo of each
  jar on its own, then shows above that card's colour bar.
  Styles come from prodani-spreads.css (the same cards as on the spreads page).
{%- endcomment -%}
{{ 'prodani-spreads.css' | asset_url | stylesheet_tag }}

{%- assign flavors = section.blocks | where: 'type', 'flavor' -%}
<section class="pd-spreads pd-spreads--home"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} aria-labelledby="pd-trio-{{ section.id }}">
  <div class="pd-spreads__trio">
    <div class="pd-wrap">
      <div class="pd-sec-head">
        <div>
          <p class="pd-eyebrow" style="margin:0 0 10px">
            {{- section.settings.eyebrow | escape -}}
            {%- if section.settings.soon_label != blank %} <span class="pd-tag pd-tag--berry pd-spreads__home-soon">{{ section.settings.soon_label | escape }}</span>{% endif -%}
          </p>
          <h2 class="pd-spreads__h2" id="pd-trio-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
        <div class="pd-spreads__home-side">
          {%- if section.settings.lede != blank -%}<p class="pd-lede pd-spreads__trio-lede" style="margin:0">{{ section.settings.lede | escape }}</p>{%- endif -%}
          {%- if section.settings.cta_label != blank -%}
            <a class="pd-btn pd-btn--ghost" href="{{ section.settings.cta_link | default: '/pages/spreads' }}">{{ section.settings.cta_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
      <ol class="pd-spreads__cards">
        {%- for block in flavors -%}
          <li class="pd-spreads__card" style="--accent:{{ block.settings.accent | default: '#6B3B28' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="pd-spreads__card-media">
                {{ block.settings.image | image_url: width: 900
                   | image_tag: loading: 'lazy', widths: '450, 700, 900',
                     sizes: '(min-width: 981px) 30vw, 92vw', alt: block.settings.alt }}
              </div>
            {%- endif -%}
            <span class="pd-spreads__card-bar" aria-hidden="true"></span>
            <p class="pd-spreads__card-n">0{{ forloop.index }}</p>
            <h3 class="pd-spreads__card-title">
              {{ block.settings.name | escape }}
              {%- if block.settings.kind != blank -%}<span>{{ block.settings.kind | escape }}</span>{%- endif -%}
            </h3>
            {%- if block.settings.tagline != blank -%}<p class="pd-spreads__card-tag">{{ block.settings.tagline | escape }}</p>{%- endif -%}
            {%- if block.settings.text != blank -%}<p class="pd-spreads__card-text">{{ block.settings.text | escape }}</p>{%- endif -%}
            <dl class="pd-spreads__card-specs">
              {%- if block.settings.direction != blank -%}
                <dt>{{ section.settings.direction_label | escape }}</dt><dd>{{ block.settings.direction | escape }}</dd>
              {%- endif -%}
              {%- if block.settings.pairs != blank -%}
                <dt>{{ section.settings.pairs_label | escape }}</dt><dd>{{ block.settings.pairs | escape }}</dd>
              {%- endif -%}
            </dl>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spreads: the trio",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "spreads" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The spread collection" },
    { "type": "text", "id": "soon_label", "label": "Tag after the eyebrow", "info": "Leave empty once the spreads are on sale.", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the trio." },
    { "type": "text", "id": "lede", "label": "Text", "default": "A color-coded family: cohesive on the shelf, distinct in flavor." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Meet the spreads" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "direction_label", "label": "\"Flavor direction\" label", "default": "Flavor direction" },
    { "type": "text", "id": "pairs_label", "label": "\"Perfect with\" label", "default": "Perfect with" }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Spread",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Hazelnut" },
        { "type": "text", "id": "kind", "label": "Small word after the name", "default": "Spread" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "direction", "label": "Flavor direction" },
        { "type": "text", "id": "pairs", "label": "Perfect with" },
        { "type": "color", "id": "accent", "label": "Accent color", "default": "#6B3B28" },
        { "type": "image_picker", "id": "image", "label": "Jar photo", "info": "Optional. Shows above the colour bar once there is a photo of this jar on its own." },
        { "type": "text", "id": "alt", "label": "Photo description" }
      ]
    }
  ],
  "presets": [{ "name": "Spreads: the trio" }]
}
{% endschema %}
