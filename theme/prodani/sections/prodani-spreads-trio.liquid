{%- comment -%}
  2026-11-19: three short cards in one row on every screen (jar, name, three words),
  then one line and the button. Less to read for a product that is not on sale yet.
  The spreads on the homepage: the "Meet the trio" cards from the spreads page
  (sections/prodani-spreads.liquid) instead of the open-box photo (Moses 2026-11-18:
  "I love this so much more"). Each card shows its own jar (an uploaded photo, or the
  bundled one), so the three read as three spreads, not one set. The text and the
  "Meet the spreads" button come after the cards.
  Styles come from prodani-spreads.css (the same cards as on the spreads page).
{%- endcomment -%}
{{ 'prodani-spreads.css' | asset_url | stylesheet_tag }}

{%- assign flavors = section.blocks | where: 'type', 'flavor' -%}
<section class="pd-spreads pd-spreads--home"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} aria-labelledby="pd-trio-{{ section.id }}">
  <div class="pd-spreads__trio">
    <div class="pd-wrap">
      <div class="pd-sec-head">
        <div>
          <p class="pd-eyebrow" style="margin:0 0 10px">
            {{- section.settings.eyebrow | escape -}}
            {%- if section.settings.soon_label != blank %} <span class="pd-tag pd-tag--berry pd-spreads__home-soon">{{ section.settings.soon_label | escape }}</span>{% endif -%}
          </p>
          <h2 class="pd-spreads__h2" id="pd-trio-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      {%- comment -%} Tweaks 6 (Moses 2026-11-19): no jar photos and no full-screen height. The
          trio is set as type, the way the spreads page opens (prodani-spreads.liquid): three
          ruled cells, a colour chip and number, the name huge, then the kind. Tweaks 8: the jar photo
          shows on hover only. {%- endcomment -%}
      <ol class="pd-spreads__type pd-spreads__type--home">
        {%- for block in flavors -%}
          <li class="pd-spreads__type-cell" style="--accent:{{ block.settings.accent | default: '#6B3B28' }}" {{ block.shopify_attributes }}>
            <span class="pd-spreads__type-n" aria-hidden="true">0{{ forloop.index }}</span>
            <h3 class="pd-spreads__type-name">{{ block.settings.name | escape }}</h3>
            {%- comment -%} Tweaks 8 (Moses 2026-11-19): hovering a spread reveals its jar photo. {%- endcomment -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '', class: 'pd-spreads__type-img' }}
            {%- elsif block.settings.bundled != blank and block.settings.bundled != 'none' -%}
              <img class="pd-spreads__type-img" src="{{ 'prodani-spread-' | append: block.settings.bundled | append: '.jpg' | asset_url }}" alt="" width="400" height="500" loading="lazy">
            {%- endif -%}
            <span class="pd-spreads__type-kind">{{ block.settings.kind | default: 'Spread' | escape }}{% if section.settings.soon_label != blank %} &middot; {{ section.settings.soon_label | escape }}{% endif %}</span>
          </li>
        {%- endfor -%}
      </ol>
      <div class="pd-spreads__home-foot">
        {%- if section.settings.lede != blank -%}<p class="pd-lede pd-spreads__trio-lede">{{ section.settings.lede | escape }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="pd-btn pd-btn--ghost" href="{{ section.settings.cta_link | default: '/pages/spreads' }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spreads: the trio",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "spreads" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The spread collection" },
    { "type": "text", "id": "soon_label", "label": "Tag after the eyebrow", "info": "Leave empty once the spreads are on sale.", "default": "Coming soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the trio." },
    { "type": "text", "id": "lede", "label": "Text", "default": "A color-coded family: cohesive on the shelf, distinct in flavor." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Meet the spreads" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "direction_label", "label": "\"Flavor direction\" label", "default": "Flavor direction" },
    { "type": "text", "id": "pairs_label", "label": "\"Perfect with\" label", "default": "Perfect with" }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Spread",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Hazelnut" },
        { "type": "text", "id": "kind", "label": "Small word after the name", "default": "Spread" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "direction", "label": "Flavor direction" },
        { "type": "text", "id": "pairs", "label": "Perfect with" },
        { "type": "color", "id": "accent", "label": "Accent color", "default": "#6B3B28" },
        { "type": "image_picker", "id": "image", "label": "Jar photo", "info": "Shows above the colour bar. If empty, the bundled photo below is used." },
        { "type": "select", "id": "bundled", "label": "Bundled jar photo", "default": "none",
          "options": [ { "value": "none", "label": "None" }, { "value": "hazelnut", "label": "Hazelnut" }, { "value": "pistachio", "label": "Pistachio" }, { "value": "cookie-butter", "label": "Lotus (cookie butter)" } ] },
        { "type": "text", "id": "alt", "label": "Photo description" }
      ]
    }
  ],
  "presets": [{ "name": "Spreads: the trio" }]
}
{% endschema %}
