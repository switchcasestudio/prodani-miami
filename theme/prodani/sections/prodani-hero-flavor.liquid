{%- comment -%} Flavor hero: one flavor in the spotlight, price and macros read live from the product. {%- endcomment -%}
{{ 'prodani-hero-flavor.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.product
  assign next_p = section.settings.next_product
  assign handle = p.handle | default: 'dubai-dream-cake-copy'
-%}
{%- capture fm -%}{% render 'prodani-flavor-map', handle: handle %}{%- endcapture -%}
{%- assign f = fm | strip | split: '|' -%}
{%- capture nm -%}{% render 'prodani-flavor-map', handle: next_p.handle %}{%- endcapture -%}
{%- assign n = nm | strip | split: '|' -%}
{%- comment -%}
  Macro Bold hero (2026-11-10, recomposed 2026-11-18): the numbers are the headline.
  The headline reads the spotlight product's protein live; {protein} in the setting is
  replaced with it.
{%- endcomment -%}
{%- liquid
  assign protein = p.metafields.prodani.protein_g.value
  assign cals = p.metafields.prodani.calories.value
  assign headline = section.settings.headline | default: '{protein}g protein. 0g added sugar. It’s cake.'
  if protein != blank
    assign headline = headline | replace: '{protein}', protein
  else
    assign headline = headline | replace: '{protein}g protein. ', '' | replace: '{protein}', ''
  endif
  assign lines = headline | split: '. '
  assign third = blank
  if section.settings.third_product != blank
    capture tm
      render 'prodani-flavor-map', handle: section.settings.third_product.handle
    endcapture
    assign tb = tm | strip | split: '|'
    assign third = tb[4]
  endif
  for prod in collections['personal-protein-cakes'].products
    if third == blank and prod.handle != p.handle and prod.handle != next_p.handle
      capture tm
        render 'prodani-flavor-map', handle: prod.handle
      endcapture
      assign tb = tm | strip | split: '|'
      unless tb[4] == blank or tb[4] contains 'slices'
        assign third = tb[4]
      endunless
    endif
  endfor
  assign v = p.selected_or_first_available_variant
-%}
{%- comment -%}
  2026-11-18 recomposition (Moses): the whole hero is one bone canvas, no split panel.
  Hierarchy: the claim (numbers first) > the cakes > the main button > the price tag.
  Every sentence of the headline is its own line, so "0g" can never wrap away from
  "added sugar". A number with a unit ("20g") is set as a big number and a small
  lowercase g: in a condensed caps face "20G" reads as "206" and "0G" as "OG".
  Each word is its own span so the entrance can land it (prodani-motion.css):
  --l is the line, --j the word's place in its line.
{%- endcomment -%}
<section class="pd-hero pd-fh">
  <div class="pd-fh__eyebrow">
    <span class="pd-tag pd-tag--berry">{{ section.settings.eyebrow | escape }}</span>
    <a class="pd-fh__flavor" href="{{ p.url }}">{{ f[0] }} {{ f[1] }}{% if protein != blank %} · {{ protein }}<span class="pd-fh__lc">g</span> protein{% endif %}{% if cals != blank %} · {{ cals }} cal{% endif %}</a>
  </div>
  <h1 class="pd-fh__h">
    {%- for l in lines -%}
      {%- assign t = l | strip -%}
      {%- unless t contains '.' -%}{%- assign t = t | append: '.' -%}{%- endunless -%}
      {%- assign words = t | split: ' ' -%}
      {%- assign li = forloop.index0 -%}
      <span class="pd-fh__line{% if forloop.last %} pd-fh__line--u{% endif %}" style="--l:{{ li }}">
        {%- for w in words -%}
          {%- liquid
            assign num = w | remove_last: 'g'
            assign numchk = num | plus: 0 | append: ''
            assign is_qty = false
            if num != w and num != blank and numchk == num
              assign is_qty = true
            endif
          -%}
          <span class="pd-fh__w" style="--j:{{ forloop.index0 }}">
            {%- if is_qty -%}<span class="pd-fh__n">{{ num | escape }}<span class="pd-fh__u">g</span></span>{%- else -%}{{ w | escape }}{%- endif -%}
          </span>{% unless forloop.last %} {% endunless %}
        {%- endfor -%}
      </span>{% unless forloop.last %} {% endunless %}
    {%- endfor -%}
  </h1>
  <div class="pd-fh__foot">
    <p class="pd-fh__p">{{ section.settings.text | escape }}</p>
    <div class="pd-fh__cta">
      <a class="pd-btn" href="{{ p.url }}">{{ section.settings.cta_label | escape }} · {{ p.price | money }}</a>
      <a class="pd-btn pd-btn--ghost" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label | escape }}</a>
    </div>
    {%- if section.settings.macros != blank -%}
    <ul class="pd-fh__macros">
      {%- assign macros = section.settings.macros | split: ',' -%}
      {%- for m in macros -%}{%- assign bits = m | strip | split: ' ' -%}<li><b>{{ bits[0] }}</b> {{ m | strip | remove_first: bits[0] | strip }}</li>{%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
  <div class="pd-fh__art">
    {%- comment -%} The stage hugs the three trays, so the tag and the stamp stay pinned to the cakes at any width. {%- endcomment -%}
    <div class="pd-fh__stage">
    <div class="pd-fh__cakes" aria-hidden="true">
      {%- if n[4] != blank -%}<img class="pd-fh__cake pd-fh__cake--l" src="{{ n[4] | asset_url }}" alt="" width="360" height="640" decoding="async">{%- endif -%}
      <img class="pd-fh__cake pd-fh__cake--c" src="{{ f[4] | asset_url }}" alt="" width="360" height="640" fetchpriority="high">
      {%- if third != blank -%}<img class="pd-fh__cake pd-fh__cake--r" src="{{ third | asset_url }}" alt="" width="360" height="640" decoding="async">{%- endif -%}
    </div>
    {%- capture each -%}{% render 'prodani-pack-price', variant: v, mode: 'each' %}{%- endcapture -%}
    {%- comment -%} One clamp: the per-cake price, then flavor and pack on two tight lines. {%- endcomment -%}
    <a class="pd-fh__price" href="{{ p.url }}">
      {%- if each != blank -%}
        <b>{{ each | strip | remove: ' per cake' | strip_html | strip }}</b>
        <span class="pd-fh__price-unit">per cake</span>
        <small><span>{{ f[0] }} {{ f[1] }}</span><span>5-pack, {{ p.price | money }}</span></small>
      {%- else -%}
        <b>{{ p.price | money }}</b><small><span>{{ f[0] }} {{ f[1] }}</span></small>
      {%- endif -%}
    </a>
    <div class="pd-fh__sticker"><div><b>{{ collections['personal-protein-cakes'].products_count | default: 7 }}</b>flavors<br>baked weekly</div></div>
    </div>
  </div>
</section>
{%- if section.settings.show_marquee -%}
<div class="pd-mq" aria-hidden="true"><div class="pd-mq__t">
  {%- for i in (1..2) -%}
    {%- for prod in collections['personal-protein-cakes'].products -%}
      {%- capture m -%}{% render 'prodani-flavor-map', handle: prod.handle %}{%- endcapture -%}
      {%- assign b = m | strip | split: '|' -%}
      {%- if b[0] != blank -%}<span style="--c:{{ b[2] }}">{{ b[0] }} {{ b[1] }}</span>{%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
</div></div>
{%- endif -%}
{% schema %}
{
  "name": "Flavor hero",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Flavor in the spotlight" },
    { "type": "product", "id": "next_product", "label": "Second cake in the picture" },
    { "type": "product", "id": "third_product", "label": "Third cake in the picture" },
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Flavor of the week" },
    { "type": "text", "id": "headline", "label": "Headline", "info": "Sentences break onto their own lines. {protein} is replaced with the spotlight cake's protein.", "default": "{protein}g protein. 0g added sugar. It’s cake." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Main button", "default": "Shop the 5-pack" },
    { "type": "text", "id": "cta2_label", "label": "Second button", "default": "See all flavors" },
    { "type": "url", "id": "cta2_link", "label": "Second button link" },
    { "type": "checkbox", "id": "show_marquee", "label": "Flavor-name ticker under the hero", "default": false },
    { "type": "text", "id": "macros", "label": "Chips, comma separated", "default": "0g added sugar, GF gluten free, 10s to warm" }
  ],
  "presets": [{ "name": "Flavor hero" }]
}
{% endschema %}
