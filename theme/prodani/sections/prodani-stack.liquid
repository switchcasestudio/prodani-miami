{%- comment -%}
  Scroll-stacking proof cards. Each card pins to the top of its slot and scales
  down as the next rides over it, so they gather into a deck.

  The slot is ~1.9:1, so `cover` crops the product shots top and bottom. The
  current photos (2026 container shots) hold the cake between ~20% and ~75% of
  the frame height, so the default focus is 50% 40%. The old 50% 88% suited the
  launch photos and cut the top off these. Overridable per card.
{%- endcomment -%}

{{ 'prodani-stack.css' | asset_url | stylesheet_tag }}

<section class="pd-stack" data-pd-stack {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  {%- if section.settings.heading != blank -%}
    <div class="pd-wrap pd-stack__head">
      <div>
        <h2 class="pd-sec-title">{{ section.settings.heading | escape }}</h2>
        {% render 'prodani-squiggle' %}
      </div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="pd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign product = block.settings.product -%}
    <div class="pd-stack__slot" {{ block.shopify_attributes }}>
      {%- comment -%}
        Measured, not guessed: the peek label + its own bottom margin is 69.8px
        tall (devtools). 36px clipped it mid-line every time — the next card's
        edge arrived before the label cleared. 72px is the smallest step that
        lets every peek fully clear before the card behind it. The old base
        `-3vh` pull is gone too — it shifted every card up from its slot's
        centred rest position (correct for none of them), which is what made
        card 1 crowd the sticky head even with a header buffer in place.
      {%- endcomment -%}
      <div class="pd-stack__card"
           style="background-color:{{ block.settings.color }};
                  color:{{ block.settings.text_color }};
                  top:{{ forloop.index0 | times: 72 }}px;"
           data-pd-card data-index="{{ forloop.index0 }}" data-total="{{ section.blocks.size }}">
        {%- comment -%} Peek label — stays visible in the sliver above each stacked card, so
           every "prodani difference" is readable even when the card is behind others. {%- endcomment -%}
        <div class="pd-stack__peek">
          <b>{{ block.settings.figure | escape }}</b>
          <span>{{ block.settings.title | escape }}</span>
        </div>
        <div class="pd-stack__body">
          <div class="pd-stack__text">
            <span class="pd-stack__figure">{{ block.settings.figure | escape }}</span>
            <h3 class="pd-stack__title">{{ block.settings.title | escape }}</h3>
            <p class="pd-stack__desc">{{ block.settings.description | escape }}</p>
            {%- if block.settings.cta_label != blank -%}
              <a class="pd-stack__link" href="{{ block.settings.cta_link | default: routes.all_products_collection_url }}">
                {{ block.settings.cta_label | escape }}
                <svg width="22" height="12" viewBox="0 0 22 12" fill="none" aria-hidden="true">
                  <path d="M21.53 6.53a.75.75 0 0 0 0-1.06L16.76.7a.75.75 0 1 0-1.06 1.06L19.94 6l-4.24 4.24a.75.75 0 1 0 1.06 1.06l4.77-4.77ZM0 6.75h21v-1.5H0v1.5Z" fill="currentColor"/>
                </svg>
              </a>
            {%- endif -%}
          </div>

          <div class="pd-stack__media">
            <div class="pd-stack__media-inner" data-pd-card-media
                 style="--pd-focus:{{ block.settings.focus | default: '50% 40%' }};">
              {%- if product != blank and product.featured_image != blank -%}
                {{ product.featured_image
                   | image_url: width: 1200
                   | image_tag: loading: 'lazy', alt: '',
                     sizes: '(min-width: 761px) 58vw, 92vw',
                     widths: '400, 620, 900, 1200' }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image
                   | image_url: width: 1200
                   | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- endfor -%}

  {%- comment -%}
    Verified in devtools: the LAST .pd-stack__slot never stuck at all, even
    before any of today's changes — position:sticky on a final child measures
    zero range to hold in (every other slot stuck correctly; only the last one
    tracked scroll 1:1, static from the first pixel). Once this trailing spacer
    makes it a middle child again, it regains the same sticky range as the
    others — which is what actually holds the finished deck in view.
  {%- endcomment -%}
  <div class="pd-stack__tail" aria-hidden="true"></div>
</section>

<script src="{{ 'prodani-stack.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Stat deck",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What makes prodani different" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Four reasons" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "why" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "figure", "label": "Figure", "default": "20g" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "cta_label", "label": "Link label" },
        { "type": "url", "id": "cta_link", "label": "Link" },
        { "type": "product", "id": "product", "label": "Product (uses its photo)" },
        { "type": "image_picker", "id": "image", "label": "Image (if no product)" },
        { "type": "text", "id": "focus", "label": "Image focus", "info": "Vertical % picks which band of the photo stays visible, e.g. 50% 40%.", "default": "50% 40%" },
        { "type": "color", "id": "color", "label": "Card colour", "default": "#C0A472" },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#211913" }
      ]
    }
  ],
  "presets": [{ "name": "Stat deck" }]
}
{% endschema %}
