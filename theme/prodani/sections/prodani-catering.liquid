{%- comment -%}
  Event catering inquiry (2026-10-30). Built from Dani's "ProDani_Catering_Options"
  brochure, with the one change she asked for: no 70 / 100 / 150 tier cards. The
  guest types the EXACT number of cakes, and 70 is the minimum (enforced in the
  browser; the inbox sees whatever was typed).

  The form is Shopify's native {% form 'contact' %}: every contact[...] field is
  listed in the store's contact email, so Dani reads the whole brief in one message.
  No prices anywhere on purpose. Every order gets a personal quote (brochure wording).

  UNLISTED for now: nothing links here, and theme.liquid adds noindex for the
  `catering` page template until Dani approves the page.
{%- endcomment -%}

{{ 'prodani-contact.css' | asset_url | stylesheet_tag }}
{{ 'prodani-catering.css' | asset_url | stylesheet_tag }}
<script src="{{ 'prodani-catering.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign minimum = section.settings.minimum | default: 70
  assign flavors = section.settings.flavors | split: ','
-%}

<section class="pd-cat"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="pd-wrap">

    <header class="pd-cat__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="pd-sec-title">{{ heading | newline_to_br }}</h1>
      {%- if section.settings.lede != blank -%}
        <div class="pd-cat__lede pd-rte">{{ section.settings.lede }}</div>
      {%- endif -%}
      <p class="pd-cat__min">
        <span class="pd-cat__min-n">{{ minimum }}</span>
        <span class="pd-cat__min-t">{{ section.settings.minimum_label | escape }}</span>
      </p>
    </header>

    <div class="pd-cat__grid">

      {%- comment -%} ---------- the inquiry form ---------- {%- endcomment -%}
      <div class="pd-cat__formwrap" id="{{ section.settings.form_anchor | default: 'inquiry' }}">
        {%- form 'contact', class: 'pd-form pd-form--catering', data-pd-catering: '', data-min: minimum -%}
          {%- if form.posted_successfully? -%}
            <p class="pd-form__ok">{{ section.settings.success_text | escape }}</p>
          {%- elsif form.errors -%}
            <p class="pd-form__err">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          {%- comment -%} Tells catering inquiries apart from contact / wholesale mail. {%- endcomment -%}
          <input type="hidden" name="contact[Inquiry type]" value="{{ section.settings.program_label | escape }}">

          {%- comment -%} 01 quantity {%- endcomment -%}
          <fieldset class="pd-cat__step">
            <legend class="pd-cat__legend"><span>01</span>{{ section.settings.step1_title | escape }}</legend>
            <label class="pd-field pd-cat__qty">
              <span>{{ section.settings.qty_label | escape }}</span>
              <span class="pd-cat__qty-row">
                <input type="number" name="contact[Cake quantity]" min="{{ minimum }}" step="1"
                       inputmode="numeric" placeholder="{{ minimum }}" required data-pd-qty
                       data-min-msg="{{ section.settings.min_message | escape }}">
                <span class="pd-cat__qty-unit">cakes</span>
              </span>
            </label>
            {%- if section.settings.qty_help != blank -%}
              <p class="pd-cat__help">{{ section.settings.qty_help | escape }}</p>
            {%- endif -%}
          </fieldset>

          {%- comment -%} 02 presentation {%- endcomment -%}
          {%- assign choices = section.blocks | where: 'type', 'presentation' -%}
          {%- if choices.size > 0 -%}
            <fieldset class="pd-cat__step">
              <legend class="pd-cat__legend"><span>02</span>{{ section.settings.step2_title | escape }}</legend>
              <div class="pd-cat__choices">
                {%- for block in choices -%}
                  <label class="pd-cat__choice" {{ block.shopify_attributes }}>
                    <input type="radio" name="contact[Presentation]" value="{{ block.settings.title | escape }}"
                           {% if forloop.first %}required{% endif %}>
                    <span class="pd-cat__choice-body">
                      <b>{{ block.settings.title | escape }}</b>
                      {%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape }}</small>{%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
              {%- if section.settings.presentation_help != blank -%}
                <p class="pd-cat__help">{{ section.settings.presentation_help | escape }}</p>
              {%- endif -%}
            </fieldset>
          {%- endif -%}

          {%- comment -%} 03 flavors: one count per flavor, or "recommend a mix" {%- endcomment -%}
          {%- if flavors.size > 0 -%}
            <fieldset class="pd-cat__step" data-pd-flavors>
              <legend class="pd-cat__legend"><span>03</span>{{ section.settings.step3_title | escape }}</legend>
              <div class="pd-cat__flavors">
                {%- for f in flavors -%}
                  {%- assign name = f | strip -%}
                  {%- if name == blank -%}{%- continue -%}{%- endif -%}
                  <label class="pd-field pd-cat__flavor">
                    <span>{{ name | escape }}</span>
                    <input type="number" name="contact[{{ name | escape }}]" min="0" step="1"
                           inputmode="numeric" placeholder="0" data-pd-flavor>
                  </label>
                {%- endfor -%}
              </div>
              <p class="pd-cat__tally" data-pd-tally aria-live="polite" hidden></p>
              <label class="pd-cat__check">
                <input type="checkbox" name="contact[Flavor mix]" value="{{ section.settings.mix_label | escape }}" data-pd-mix>
                <span>{{ section.settings.mix_label | escape }}</span>
              </label>
              {%- if section.settings.flavor_help != blank -%}
                <p class="pd-cat__help">{{ section.settings.flavor_help | escape }}</p>
              {%- endif -%}
            </fieldset>
          {%- endif -%}

          {%- comment -%} 04 personal touch {%- endcomment -%}
          <fieldset class="pd-cat__step">
            <legend class="pd-cat__legend"><span>04</span>{{ section.settings.step4_title | escape }}</legend>
            <label class="pd-field">
              <span>{{ section.settings.custom_label | escape }}</span>
              <textarea name="contact[Customization]" rows="3" placeholder="{{ section.settings.custom_placeholder | escape }}"></textarea>
            </label>
            {%- if section.settings.custom_help != blank -%}
              <p class="pd-cat__help">{{ section.settings.custom_help | escape }}</p>
            {%- endif -%}
          </fieldset>

          {%- comment -%} 05 the event {%- endcomment -%}
          <fieldset class="pd-cat__step">
            <legend class="pd-cat__legend"><span>05</span>{{ section.settings.step5_title | escape }}</legend>
            <div class="pd-cat__two">
              <label class="pd-field">
                <span>Event date</span>
                <input type="date" name="contact[Event date]" required>
              </label>
              <label class="pd-field">
                <span>Guest count</span>
                <input type="number" name="contact[Guest count]" min="1" step="1" inputmode="numeric" placeholder="80">
              </label>
            </div>
            <label class="pd-field">
              <span>Event location</span>
              <input type="text" name="contact[Event location]" autocomplete="address-level2" placeholder="Venue or neighborhood, Miami" required>
            </label>
            <div class="pd-cat__two">
              <label class="pd-field">
                <span>Delivery or pickup</span>
                <select name="contact[Delivery or pickup]">
                  <option value="Delivery">Delivery</option>
                  <option value="Pickup">Pickup</option>
                  <option value="Not sure yet">Not sure yet</option>
                </select>
              </label>
              <label class="pd-field">
                <span>Allergies or dietary needs</span>
                <input type="text" name="contact[Allergies or dietary needs]" placeholder="None that we know of">
              </label>
            </div>
          </fieldset>

          {%- comment -%} 06 you {%- endcomment -%}
          <fieldset class="pd-cat__step">
            <legend class="pd-cat__legend"><span>06</span>{{ section.settings.step6_title | escape }}</legend>
            <div class="pd-cat__two">
              <label class="pd-field">
                <span>Your name</span>
                <input type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
              </label>
              <label class="pd-field">
                <span>Phone</span>
                <input type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel" inputmode="tel" placeholder="+1 305 000 0000">
              </label>
            </div>
            <label class="pd-field">
              <span>Email</span>
              <input type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
            </label>
            <label class="pd-field">
              <span>{{ section.settings.message_label | escape }}</span>
              <textarea name="contact[body]" rows="4" required placeholder="{{ section.settings.message_placeholder | escape }}">{{ form.body }}</textarea>
            </label>
          </fieldset>

          <div class="pd-cat__submit">
            <button type="submit" class="pd-btn pd-btn--pink">{{ section.settings.button_label | escape }}</button>
            {%- if section.settings.fine_print != blank -%}
              <p class="pd-cat__fine">{{ section.settings.fine_print | escape }}</p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>

      {%- comment -%} ---------- aside: how it works + good to know ---------- {%- endcomment -%}
      {%- assign steps = section.blocks | where: 'type', 'step' -%}
      <aside class="pd-cat__aside">
        {%- if steps.size > 0 -%}
          <div class="pd-cat__panel">
            <h2 class="pd-cat__sub">{{ section.settings.aside_heading | escape }}</h2>
            <ol class="pd-cat__steps">
              {%- for block in steps -%}
                <li {{ block.shopify_attributes }}>
                  <span class="pd-cat__step-n">{{ forloop.index }}</span>
                  <span class="pd-cat__step-body">
                    <b>{{ block.settings.title | escape }}</b>
                    {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ol>
          </div>
        {%- endif -%}
        {%- if section.settings.notes != blank -%}
          <div class="pd-cat__panel pd-cat__panel--notes">
            <h2 class="pd-cat__sub">{{ section.settings.notes_heading | escape }}</h2>
            <div class="pd-rte pd-cat__notes">{{ section.settings.notes }}</div>
          </div>
        {%- endif -%}
      </aside>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Catering inquiry",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Event catering" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "A sweet addition.\nFor every occasion." },
    { "type": "richtext", "id": "lede", "label": "Intro copy", "default": "<p>Protein cakes for weddings, celebrations, corporate gatherings and wellness events. Choose your quantity, mix your flavors and make it yours.</p>" },
    { "type": "header", "content": "Minimum" },
    { "type": "range", "id": "minimum", "label": "Minimum cakes", "min": 10, "max": 200, "step": 5, "default": 70 },
    { "type": "text", "id": "minimum_label", "label": "Minimum label", "default": "cake minimum" },
    { "type": "text", "id": "min_message", "label": "Message when under the minimum", "default": "The minimum order is 70 cakes." },
    { "type": "header", "content": "Step 1: quantity" },
    { "type": "text", "id": "step1_title", "label": "Title", "default": "Choose your quantity" },
    { "type": "text", "id": "qty_label", "label": "Field label", "default": "How many cakes?" },
    { "type": "text", "id": "qty_help", "label": "Help text", "default": "Quantities are flexible from 70 cakes. As a simple starting point, plan one cake per guest, then add any take-home cakes or extras." },
    { "type": "header", "content": "Step 2: presentation" },
    { "type": "text", "id": "step2_title", "label": "Title", "default": "Pick your presentation" },
    { "type": "text", "id": "presentation_help", "label": "Help text", "default": "Presentation and packaging details are confirmed with your personalized quote." },
    { "type": "header", "content": "Step 3: flavors" },
    { "type": "text", "id": "step3_title", "label": "Title", "default": "Build your flavor selection" },
    {
      "type": "textarea", "id": "flavors", "label": "Flavors (comma separated)",
      "info": "One number field per flavor. From Dani's brochure; switch to the live cake list here when confirmed.",
      "default": "Hazelnut, Chocolate Fudge, Pistachio, White Chocolate Matcha"
    },
    { "type": "text", "id": "mix_label", "label": "Recommend-a-mix option", "default": "Recommend a balanced mix for me" },
    { "type": "text", "id": "flavor_help", "label": "Help text", "default": "Tell us the exact number of each flavor, or ask us to recommend a balanced mix. Flavor availability is confirmed for your event date." },
    { "type": "header", "content": "Step 4: personal touch" },
    { "type": "text", "id": "step4_title", "label": "Title", "default": "Add a personal touch" },
    { "type": "text", "id": "custom_label", "label": "Field label", "default": "Theme, message or branding idea (optional)" },
    { "type": "text", "id": "custom_placeholder", "label": "Placeholder", "default": "Logo on the box, a message on each cake, colors to match the event..." },
    { "type": "text", "id": "custom_help", "label": "Help text", "default": "Customization is available at an additional cost. We will confirm available options and pricing." },
    { "type": "header", "content": "Steps 5 and 6" },
    { "type": "text", "id": "step5_title", "label": "Step 5 title", "default": "Your event" },
    { "type": "text", "id": "step6_title", "label": "Step 6 title", "default": "Your details" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Anything else we should know?" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "The occasion, timing on the day, who to call at the venue..." },
    { "type": "header", "content": "Submit" },
    { "type": "text", "id": "program_label", "label": "Inquiry type (hidden field)", "info": "Sent with the message so catering mail is easy to spot in the inbox.", "default": "Event catering" },
    { "type": "text", "id": "form_anchor", "label": "Form anchor id", "default": "inquiry" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start your catering inquiry" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Every order receives a personalized quote. Cake pricing, packaging, customization and any delivery charges are confirmed before booking." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you. We will come back to you with a personalized quote shortly." },
    { "type": "header", "content": "Side panel" },
    { "type": "text", "id": "aside_heading", "label": "Steps heading", "default": "How it works" },
    { "type": "text", "id": "notes_heading", "label": "Notes heading", "default": "Good to know" },
    { "type": "richtext", "id": "notes", "label": "Notes", "default": "<p>70 cakes minimum. Hosting more? Choose 200, 300 or your exact quantity.</p><p>Please share any allergies or dietary requirements so we can confirm what we can accommodate.</p><p>Delivery or pickup, your choice. Delivery charges are confirmed with your quote.</p>" }
  ],
  "blocks": [
    {
      "type": "presentation",
      "name": "Presentation option",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Individual treats" },
        { "type": "text", "id": "text", "label": "Text", "default": "One for each guest." }
      ]
    },
    {
      "type": "step",
      "name": "How-it-works step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "New step" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Catering inquiry" }]
}
{% endschema %}
