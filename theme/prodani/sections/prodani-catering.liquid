{%- comment -%}
  Event catering inquiry (2026-10-30, reworked the same evening after Moses: "looks a
  little daunting"). Built from Dani's "ProDani_Catering_Options" brochure with her one
  change: no 70 / 100 / 150 tier cards, the guest types the EXACT number (minimum 70).

  UX: a guided four-step flow instead of one long dark form. One step on screen at a
  time, a step list on the left that fills with one-line summaries as answers come in,
  four required fields in total (cakes, date, name, email). Without JavaScript all four
  steps simply stack and the form still posts. After a server-side error every step is
  shown so nothing is hidden behind a "Continue" button.

  Shopify's native {% form 'contact' %}: every contact[...] field is listed in the
  store's contact email, with readable keys ("Cake quantity", "Hazelnut"...). No prices
  anywhere on purpose; every order gets a personal quote (brochure wording).

  Linked from the footer and open to search engines since 2026-10-30.
{%- endcomment -%}

{{ 'prodani-catering.css' | asset_url | stylesheet_tag }}
<script src="{{ 'prodani-catering.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign minimum = section.settings.minimum | default: 70
  assign flavors = section.settings.flavors | split: ','
  assign choices = section.blocks | where: 'type', 'presentation'
-%}

<section class="pd-cat"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="pd-wrap">

    <header class="pd-cat__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="pd-sec-title">{{ heading | newline_to_br }}</h1>
      {%- if section.settings.lede != blank -%}
        <p class="pd-cat__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
      {%- if section.settings.meta != blank -%}
        <p class="pd-cat__meta">{{ section.settings.meta | escape }}</p>
      {%- endif -%}
    </header>

    {%- form 'contact', class: 'pd-cat__form', data-pd-catering: '', data-min: minimum -%}
      {%- if form.posted_successfully? -%}

        <div class="pd-cat__done" role="status">
          <h2>{{ section.settings.success_heading | escape }}</h2>
          <p>{{ section.settings.success_text | escape }}</p>
          <a class="pd-btn" href="{{ routes.root_url }}">{{ section.settings.success_button | escape }}</a>
        </div>

      {%- else -%}

        <div class="pd-cat__grid"{% if form.errors %} data-errors{% endif %}>

          {%- comment -%} step list: numbers + titles, summaries filled by JS {%- endcomment -%}
          <nav class="pd-cat__nav" aria-label="Steps">
            <ol class="pd-cat__steps" data-pd-nav>
              <li data-step="1"><button type="button" data-goto="1"><span class="pd-cat__n">1</span><span class="pd-cat__nt"><b>{{ section.settings.step1_title | escape }}</b><small data-summary="1"></small></span></button></li>
              <li data-step="2"><button type="button" data-goto="2"><span class="pd-cat__n">2</span><span class="pd-cat__nt"><b>{{ section.settings.step2_title | escape }}</b><small data-summary="2"></small></span></button></li>
              <li data-step="3"><button type="button" data-goto="3"><span class="pd-cat__n">3</span><span class="pd-cat__nt"><b>{{ section.settings.step3_title | escape }}</b><small data-summary="3"></small></span></button></li>
              <li data-step="4"><button type="button" data-goto="4"><span class="pd-cat__n">4</span><span class="pd-cat__nt"><b>{{ section.settings.step4_title | escape }}</b><small data-summary="4"></small></span></button></li>
            </ol>
          </nav>

          <div class="pd-cat__card">
            <div class="pd-cat__bar" aria-hidden="true"><span data-pd-bar></span></div>
            <p class="pd-cat__count" data-pd-count aria-live="polite"></p>

            {%- if form.errors -%}
              <p class="pd-cat__err" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <input type="hidden" name="contact[Inquiry type]" value="{{ section.settings.program_label | escape }}">

            {%- comment -%} 1. cakes {%- endcomment -%}
            <fieldset class="pd-cat__step" data-step="1">
              <legend class="pd-cat__legend">{{ section.settings.step1_question | escape }}</legend>
              {%- if section.settings.step1_help != blank -%}<p class="pd-cat__help">{{ section.settings.step1_help | escape }}</p>{%- endif -%}
              <div class="pd-cat__qty">
                <button type="button" class="pd-cat__qty-btn" data-qty-dec aria-label="Ten fewer cakes">&minus;</button>
                <label class="pd-cat__qty-field">
                  <span class="pd-sr-only">{{ section.settings.step1_question | escape }}</span>
                  <input type="number" name="contact[Cake quantity]" min="{{ minimum }}" step="1" inputmode="numeric"
                         placeholder="{{ minimum }}" required data-pd-qty data-min-msg="{{ section.settings.min_message | escape }}">
                  <span class="pd-cat__qty-unit">cakes</span>
                </label>
                <button type="button" class="pd-cat__qty-btn" data-qty-inc aria-label="Ten more cakes">+</button>
              </div>
              <p class="pd-cat__hint" data-pd-qty-hint>{{ section.settings.step1_hint | escape }}</p>
            </fieldset>

            {%- comment -%} 2. flavors + presentation {%- endcomment -%}
            <fieldset class="pd-cat__step" data-step="2">
              <legend class="pd-cat__legend">{{ section.settings.step2_question | escape }}</legend>
              {%- if section.settings.step2_help != blank -%}<p class="pd-cat__help">{{ section.settings.step2_help | escape }}</p>{%- endif -%}
              {%- if flavors.size > 0 -%}
                <div class="pd-cat__flavors" data-pd-flavors>
                  {%- for f in flavors -%}
                    {%- assign name = f | strip -%}
                    {%- if name == blank -%}{%- continue -%}{%- endif -%}
                    <label class="pd-cat__flavor">
                      <span>{{ name | escape }}</span>
                      <input type="number" name="contact[{{ name | escape }}]" min="0" step="1" inputmode="numeric" placeholder="0" data-pd-flavor>
                    </label>
                  {%- endfor -%}
                </div>
                <p class="pd-cat__tally" data-pd-tally aria-live="polite" hidden></p>
                <label class="pd-cat__check">
                  <input type="checkbox" name="contact[Flavor mix]" value="{{ section.settings.mix_label | escape }}" data-pd-mix>
                  <span>{{ section.settings.mix_label | escape }}</span>
                </label>
              {%- endif -%}
              {%- if choices.size > 0 -%}
                <p class="pd-cat__sub" id="pd-cat-pres">{{ section.settings.presentation_label | escape }}</p>
                <div class="pd-cat__choices" role="radiogroup" aria-labelledby="pd-cat-pres">
                  {%- for block in choices -%}
                    <label class="pd-cat__choice" {{ block.shopify_attributes }}>
                      <input type="radio" name="contact[Presentation]" value="{{ block.settings.title | escape }}">
                      <span class="pd-cat__choice-body"><b>{{ block.settings.title | escape }}</b>{%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape }}</small>{%- endif -%}</span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </fieldset>

            {%- comment -%} 3. event {%- endcomment -%}
            <fieldset class="pd-cat__step" data-step="3">
              <legend class="pd-cat__legend">{{ section.settings.step3_question | escape }}</legend>
              <div class="pd-cat__two">
                <label class="pd-cat__field">
                  <span>Event date</span>
                  <input type="date" name="contact[Event date]" required data-summary-date>
                </label>
                <label class="pd-cat__field">
                  <span>Delivery or pickup</span>
                  <select name="contact[Delivery or pickup]" data-summary-delivery>
                    <option value="Delivery">Delivery</option>
                    <option value="Pickup">Pickup</option>
                    <option value="Not sure yet">Not sure yet</option>
                  </select>
                </label>
              </div>
              <label class="pd-cat__field">
                <span>City or venue <em>optional</em></span>
                <input type="text" name="contact[Event location]" autocomplete="address-level2" placeholder="Wynwood, Miami">
              </label>
              <details class="pd-cat__more">
                <summary>{{ section.settings.extras_label | escape }}</summary>
                <div class="pd-cat__more-body">
                  <label class="pd-cat__field">
                    <span>Theme, message or branding</span>
                    <textarea name="contact[Customization]" rows="2" placeholder="{{ section.settings.custom_placeholder | escape }}"></textarea>
                  </label>
                  {%- if section.settings.custom_help != blank -%}<p class="pd-cat__help">{{ section.settings.custom_help | escape }}</p>{%- endif -%}
                  <label class="pd-cat__field">
                    <span>Allergies or dietary needs</span>
                    <input type="text" name="contact[Allergies or dietary needs]" placeholder="None that we know of">
                  </label>
                </div>
              </details>
            </fieldset>

            {%- comment -%} 4. details {%- endcomment -%}
            <fieldset class="pd-cat__step" data-step="4">
              <legend class="pd-cat__legend">{{ section.settings.step4_question | escape }}</legend>
              <div class="pd-cat__two">
                <label class="pd-cat__field">
                  <span>Your name</span>
                  <input type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required data-summary-name>
                </label>
                <label class="pd-cat__field">
                  <span>Phone <em>optional</em></span>
                  <input type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel" inputmode="tel" placeholder="+1 305 000 0000">
                </label>
              </div>
              <label class="pd-cat__field">
                <span>Email</span>
                <input type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
              </label>
              <label class="pd-cat__field">
                <span>{{ section.settings.message_label | escape }}</span>
                <textarea name="contact[body]" rows="3" required placeholder="{{ section.settings.message_placeholder | escape }}">{{ form.body }}</textarea>
              </label>
            </fieldset>

            <div class="pd-cat__actions">
              <button type="button" class="pd-cat__back" data-prev>Back</button>
              <button type="button" class="pd-btn" data-next>{{ section.settings.next_label | escape }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg>
              </button>
              <button type="submit" class="pd-btn" data-submit>{{ section.settings.button_label | escape }}</button>
            </div>
            {%- if section.settings.fine_print != blank -%}
              <p class="pd-cat__fine">{{ section.settings.fine_print | escape }}</p>
            {%- endif -%}
          </div>
        </div>

      {%- endif -%}
    {%- endform -%}

  </div>
</section>

{% schema %}
{
  "name": "Catering inquiry",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Event catering" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Cakes for your event." },
    { "type": "text", "id": "lede", "label": "Intro line", "default": "Weddings, celebrations, corporate gatherings and wellness events. Tell us about yours and we reply personally with a quote." },
    { "type": "text", "id": "meta", "label": "Small line under the intro", "default": "Four short steps. Minimum 70 cakes. No payment now." },
    { "type": "header", "content": "Minimum" },
    { "type": "range", "id": "minimum", "label": "Minimum cakes", "min": 10, "max": 200, "step": 5, "default": 70 },
    { "type": "text", "id": "min_message", "label": "Message when under the minimum", "default": "The minimum order is 70 cakes." },
    { "type": "header", "content": "Step 1: cakes" },
    { "type": "text", "id": "step1_title", "label": "Step name", "default": "Cakes" },
    { "type": "text", "id": "step1_question", "label": "Question", "default": "How many cakes?" },
    { "type": "text", "id": "step1_help", "label": "Help text", "default": "Minimum 70. One cake per guest is a good starting point, plus any take-home extras." },
    { "type": "text", "id": "step1_hint", "label": "Hint under the number", "default": "Any number from 70 up. Not sure yet? A rough number is fine, we refine it together." },
    { "type": "header", "content": "Step 2: flavors and presentation" },
    { "type": "text", "id": "step2_title", "label": "Step name", "default": "Flavors" },
    { "type": "text", "id": "step2_question", "label": "Question", "default": "Which flavors, and how will you serve them?" },
    { "type": "text", "id": "step2_help", "label": "Help text", "default": "Type a number per flavor, or tick the box and we suggest a mix. Availability is confirmed for your date." },
    {
      "type": "textarea", "id": "flavors", "label": "Flavors (comma separated)",
      "info": "One number field per flavor. From Dani's brochure; switch to the live cake list here when confirmed.",
      "default": "Hazelnut, Chocolate Fudge, Pistachio, White Chocolate Matcha"
    },
    { "type": "text", "id": "mix_label", "label": "Recommend-a-mix option", "default": "Suggest a balanced mix for me" },
    { "type": "text", "id": "presentation_label", "label": "Presentation label", "default": "How will you serve them?" },
    { "type": "header", "content": "Step 3: event" },
    { "type": "text", "id": "step3_title", "label": "Step name", "default": "Event" },
    { "type": "text", "id": "step3_question", "label": "Question", "default": "When and where?" },
    { "type": "text", "id": "extras_label", "label": "Optional extras toggle", "default": "Add a personal touch or dietary notes (optional)" },
    { "type": "text", "id": "custom_placeholder", "label": "Customization placeholder", "default": "Logo on the box, a message on each cake, colors to match the event..." },
    { "type": "text", "id": "custom_help", "label": "Customization help", "default": "Customization is available at an additional cost. We confirm options and pricing with your quote." },
    { "type": "header", "content": "Step 4: details" },
    { "type": "text", "id": "step4_title", "label": "Step name", "default": "Details" },
    { "type": "text", "id": "step4_question", "label": "Question", "default": "Where should we send the quote?" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "A line about the event" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "The occasion, timing on the day, anything we should know." },
    { "type": "header", "content": "Buttons and messages" },
    { "type": "text", "id": "next_label", "label": "Continue button", "default": "Continue" },
    { "type": "text", "id": "button_label", "label": "Send button", "default": "Send my inquiry" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Pricing, packaging, customization and delivery are confirmed in your personalized quote, before anything is booked." },
    { "type": "text", "id": "program_label", "label": "Inquiry type (hidden field)", "info": "Sent with the message so catering mail is easy to spot in the inbox.", "default": "Event catering" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Got it. Thank you." },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "We will come back to you personally with a quote for your event." },
    { "type": "text", "id": "success_button", "label": "Success button", "default": "Back to the bakery" }
  ],
  "blocks": [
    {
      "type": "presentation",
      "name": "Presentation option",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Individual treats" },
        { "type": "text", "id": "text", "label": "Text", "default": "One for each guest." }
      ]
    }
  ],
  "presets": [{ "name": "Catering inquiry" }]
}
{% endschema %}
