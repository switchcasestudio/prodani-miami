{%- comment -%}
  Meet Your Baker — ported from the React prototype's Story component.

  The live store's page body is EMPTY in the database: every word currently on
  /pages/meet-your-baker lives inside the old theme's page.about-us.json. So this
  section carries the copy as editable settings rather than reading page.content,
  which would render blank. If Daniel ever moves the copy into the page body, set
  "Use the page's own content" and it will prefer that instead.
{%- endcomment -%}

{{ 'prodani-baker.css' | asset_url | stylesheet_tag }}

<section class="pd-story" id="baker-{{ section.id }}">
  <div class="pd-wrap">
    <div class="pd-sec-head">
      <div>
        <{{ section.settings.heading_tag | default: 'h1' }} class="pd-sec-title">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag | default: 'h1' }}>
        {% render 'prodani-squiggle' %}
      </div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="pd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
    </div>

    <div class="pd-story__in">
      <div class="pd-story__text">
        {%- if section.settings.use_page_content and page.content != blank -%}
          <div class="pd-rte">{{ page.content }}</div>
        {%- else -%}
          {%- if section.settings.lede != blank -%}
            <p class="pd-lede pd-lede--intro">{{ section.settings.lede }}</p>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="pd-rte">{{ section.settings.body }}</div>
          {%- endif -%}
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="pd-story__list">
            {%- for block in section.blocks -%}
              {%- comment -%} Line icon per pillar (Moses 2026-10-11: the rows read empty). The
                  same 2026 line set as the benefit strip; "Auto" picks it from the label. {%- endcomment -%}
              {%- liquid
                assign icon = block.settings.icon | default: 'auto'
                if icon == 'auto'
                  assign key = block.settings.label | downcase
                  if key contains 'sugar' or key contains 'sweet'
                    assign icon = 'prodani-icon-no-added-sugar'
                  elsif key contains 'flour' or key contains 'gluten'
                    assign icon = 'prodani-icon-gluten-free'
                  elsif key contains 'protein'
                    assign icon = 'prodani-icon-protein'
                  else
                    assign icon = 'prodani-icon-small-batch'
                  endif
                endif
              -%}
              <li {{ block.shopify_attributes }}>
                {%- if icon != 'none' -%}
                  <span class="pd-story__icon" aria-hidden="true">{{ icon | append: '.svg' | inline_asset_content }}</span>
                {%- endif -%}
                <span class="pd-story__copy">
                  <b>{{ block.settings.label | escape }}</b>
                  <span>{{ block.settings.text | escape }}</span>
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- assign story_img = section.settings.image -%}
      {%- if story_img == blank and section.settings.product != blank -%}
        {%- assign story_img = section.settings.product.featured_image -%}
      {%- endif -%}
      {%- if story_img == blank and section.settings.bundled_photo != 'none' -%}
        <div class="pd-story__media">
          {%- comment -%}
            Real intrinsic size (800x1200) so the browser reserves the right box and
            nothing shifts on load. These are safe only because the CSS declares
            `height:auto` — an author rule beats the attribute's presentational hint.
            Without it the attribute wins and aspect-ratio is ignored entirely, which
            is what rendered this photo 1500px tall next to 563px of text.
          {%- endcomment -%}
          <img src="{{ section.settings.bundled_photo | append: '.jpg' | asset_url }}"
               alt="{{ section.settings.image_alt | escape }}" loading="lazy"
               width="800" height="1200"
               style="object-position:{{ section.settings.photo_focus | default: '50% 10%' }};">
          {%- if section.settings.stamp != blank -%}
            <div class="pd-story__stamp">{{ section.settings.stamp }}</div>
          {%- endif -%}
        </div>
      {%- elsif story_img != blank -%}
        <div class="pd-story__media">
          {{ story_img
             | image_url: width: 1100
             | image_tag:
               loading: 'lazy',
               sizes: '(min-width: 981px) 40vw, 92vw',
               widths: '400, 600, 800, 1100',
               alt: section.settings.image_alt | default: section.settings.heading }}
          {%- if section.settings.stamp != blank -%}
            <div class="pd-story__stamp">{{ section.settings.stamp }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meet your baker",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet your baker" },
    {
      "type": "select", "id": "heading_tag", "label": "Heading level",
      "info": "h1 on its own page; h2 when used as a section on another page.",
      "options": [{ "value": "h1", "label": "h1 (page)" }, { "value": "h2", "label": "h2 (section)" }],
      "default": "h1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Miami · since 2023" },
    {
      "type": "checkbox",
      "id": "use_page_content",
      "label": "Use the page's own content instead",
      "info": "Off by default — this page's body is empty in the admin, so the copy below is used.",
      "default": false
    },
    { "type": "richtext", "id": "lede", "label": "Opening line" },
    { "type": "richtext", "id": "body", "label": "Body copy" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "product", "id": "product", "label": "Product (photo used if no image picked)" },
    {
      "type": "select", "id": "bundled_photo", "label": "Bundled photo",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "prodani-dani-1", "label": "Dani — portrait" },
        { "value": "prodani-dani-2", "label": "Dani — with cake" },
        { "value": "prodani-trays", "label": "Tray spread" }
      ],
      "default": "prodani-dani-1"
    },
    { "type": "text", "id": "image_alt", "label": "Photo alt text" },
    {
      "type": "text", "id": "photo_focus", "label": "Photo focus",
      "info": "The frame is wider than these portraits, so a centred crop clips the head. 50% 10% keeps it.",
      "default": "50% 10%"
    },
    { "type": "richtext", "id": "stamp", "label": "Stamp text" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "text", "label": "Text" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "auto",
          "options": [
            { "value": "auto", "label": "Auto (from the label)" },
            { "value": "prodani-icon-small-batch", "label": "Small batch" },
            { "value": "prodani-icon-no-added-sugar", "label": "No added sugar" },
            { "value": "prodani-icon-gluten-free", "label": "Gluten free" },
            { "value": "prodani-icon-protein", "label": "Protein" },
            { "value": "prodani-icon-baked-in-miami", "label": "Baked in Miami" },
            { "value": "none", "label": "No icon" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "Meet your baker" }]
}
{% endschema %}
