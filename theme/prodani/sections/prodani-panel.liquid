{%- comment -%} Image + copy panel in the theme look. Used for "A real cake" and the spreads teaser. {%- endcomment -%}
{{ 'prodani-flavor.css' | asset_url | stylesheet_tag }}
<section class="pd-fl{% if section.settings.tone == 'dark' %} pd-fl--dark{% endif %}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="pd-wrap">
    <div class="pd-panel{% if section.settings.flip %} pd-panel--flip{% endif %}">
      <div class="pd-panel__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="pd-eyebrow pd-panel__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="pd-sec-title pd-fl__h">{{ section.settings.heading }}</h2>
        <p class="pd-panel__body">{{ section.settings.body | escape }}</p>
        {%- if section.settings.cta_label != blank -%}
          <a class="pd-btn{% if section.settings.tone == 'dark' %} pd-btn--pink{% endif %}" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7"/></svg></a>
        {%- endif -%}
      </div>
      <div class="pd-panel__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image_alt, widths: '600, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw' }}
        {%- else -%}
          <img src="{{ section.settings.bundled | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1000" height="700">
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image panel",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id" },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading (em and br tags allowed)" },
    { "type": "textarea", "id": "body", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "bundled", "label": "Theme asset used if no photo picked" },
    { "type": "text", "id": "image_alt", "label": "Photo alt text" },
    { "type": "checkbox", "id": "flip", "label": "Photo on the left", "default": false },
    { "type": "select", "id": "tone", "label": "Background", "options": [ { "value": "cream", "label": "Ivory" }, { "value": "dark", "label": "Chocolate" } ], "default": "cream" }
  ],
  "presets": [{ "name": "Image panel" }]
}
{% endschema %}
