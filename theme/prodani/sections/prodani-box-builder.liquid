{%- comment -%}
  Build Your Box — Option A (custom, no app, no monthly fee).

  Dani's 2026-08-31 direction. The flow is:
      Choose Box  ->  Choose Flavors  ->  One-Time or Subscribe  ->  Checkout

  Two ways to choose a box, both feeding ONE cart path:
    - "Build your own"  — pick 6 / 12 (Most Popular) / 18 (Best Value), mix and match.
    - "Curated"         — Best Sellers / Variety etc. A curated block is a PRESET over the
                          same machinery: clicking it sets the size and fills the flavor
                          quantities, then drops you into step 2 with everything editable.
                          There is deliberately no second add-to-cart path to keep wrong.

  Curated `mix` format: "Chocolate Fudge:4, Vanilla Bean:4, Strawberry:4" — names are
  matched case-insensitively against flavor block names. Leave blank for an even spread
  across every in-stock flavor (that's the Variety box).

  Subscriptions use Shopify's NATIVE selling plans, read off the first linked flavor
  product that has a plan group. Until plans exist (ticket T12) the subscribe option
  renders as a clearly-flagged, DISABLED preview — it never fakes a subscription.

  Prices are placeholders extrapolated from the launch price points and are subject to
  the pricing check in T1 before anything goes live. Flavor names are placeholders
  pending T17.

  Box product (2026-10-08): the live flavor products are 5-cake packs, so a box can't
  be built from them. When "Box product" is set, the whole box goes to the cart as ONE
  line: the variant whose title starts with the box size ("12 cakes"), with the flavor
  mix as a line-item property. The variant's price is what checkout charges, so keep
  the size prices below equal to the variant prices. Flavors then need no product
  link. Without a box product the old per-flavor path is used.
{%- endcomment -%}
{{ 'prodani-box-builder.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign box_product = section.settings.box_product
  assign sub_group = nil
  if box_product != blank and box_product.selling_plan_groups.size > 0
    assign sub_group = box_product.selling_plan_groups | first
  endif
  for block in section.blocks
    if sub_group != nil
      break
    endif
    if block.type == 'flavor' and block.settings.product != blank
      if block.settings.product.selling_plan_groups.size > 0
        assign sub_group = block.settings.product.selling_plan_groups | first
        break
      endif
    endif
  endfor
  assign has_plans = false
  if sub_group != nil
    assign has_plans = true
  endif
-%}

<section class="pd-box pd-section" data-pd-box{% if box_product != blank %} data-pd-box-product{% endif %} aria-labelledby="pd-box-title"
         {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="pd-wrap">
    <header class="pd-sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="pd-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="pd-box-title" class="pd-sec-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="pd-lede pd-lede--intro">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    </header>

    {%- comment -%} Step 1 — choose your box {%- endcomment -%}
    <div class="pd-box__step">
      <p class="pd-box__step-label"><span>1</span> Choose your box</p>

      {%- assign curated_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'curated' -%}{%- assign curated_count = curated_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}

      {%- if curated_count > 0 -%}
        <div class="pd-box__modes" role="tablist" aria-label="How to choose your box">
          <button type="button" class="pd-box__mode" role="tab" aria-selected="true" data-pd-mode="build">
            {{ section.settings.build_tab_label | default: 'Build your own' }}
          </button>
          <button type="button" class="pd-box__mode" role="tab" aria-selected="false" data-pd-mode="curated">
            {{ section.settings.curated_tab_label | default: 'Curated boxes' }}
          </button>
        </div>
      {%- endif -%}

      {%- comment -%} 1a — sizes {%- endcomment -%}
      <div class="pd-box__sizes" role="radiogroup" aria-label="Box size" data-pd-panel="build">
        {%- assign sizes = section.settings.sizes | split: ',' -%}
        {%- assign prices = section.settings.prices | split: ',' -%}
        {%- for s in sizes -%}
          {%- assign i = forloop.index0 -%}
          {%- assign count = s | strip | plus: 0 -%}
          {%- assign price = prices[i] | strip | plus: 0 -%}
          {%- comment -%} float math so 49/6 reads $8.17, not integer $8 {%- endcomment -%}
          {%- assign per = price | times: 100.0 | divided_by: count | round: 0 | money_without_currency -%}
          {%- assign box_variant = '' -%}
          {%- if box_product != blank -%}
            {%- for v in box_product.variants -%}
              {%- assign v_size = v.title | split: ' ' | first | plus: 0 -%}
              {%- if v_size == count and v.available -%}{%- assign box_variant = v.id -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <button
            type="button"
            class="pd-box__size"
            role="radio"
            aria-checked="{% if forloop.index == section.settings.default_size_index %}true{% else %}false{% endif %}"
            data-size="{{ count }}"
            data-price="{{ price }}"
            data-box-variant="{{ box_variant }}"
          >
            {%- if count == section.settings.popular_count -%}<span class="pd-box__tag pd-box__tag--popular">Most Popular</span>{%- endif -%}
            {%- if count == section.settings.value_count -%}<span class="pd-box__tag pd-box__tag--value">Best Value</span>{%- endif -%}
            <span class="pd-box__size-count">{{ count }} cakes</span>
            <span class="pd-box__size-price">${{ price }}</span>
            <span class="pd-box__size-per">${{ per }}/cake</span>
          </button>
        {%- endfor -%}
      </div>

      {%- comment -%} 1b — curated presets {%- endcomment -%}
      {%- if curated_count > 0 -%}
        <div class="pd-box__curated" data-pd-panel="curated" hidden>
          {%- for block in section.blocks -%}
            {%- if block.type == 'curated' -%}
              {%- assign c_count = block.settings.size | plus: 0 -%}
              {%- assign c_price = block.settings.price | plus: 0 -%}
              <button
                type="button"
                class="pd-box__curated-card"
                data-pd-curated
                data-size="{{ c_count }}"
                data-price="{{ c_price }}"
                data-mix="{{ block.settings.mix | escape }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.badge != blank -%}
                  <span class="pd-box__tag pd-box__tag--popular">{{ block.settings.badge }}</span>
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <span class="pd-box__curated-media">
                    {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240,480', alt: block.settings.name | escape }}
                  </span>
                {%- endif -%}
                <span class="pd-box__curated-body">
                  <span class="pd-box__curated-name">{{ block.settings.name }}</span>
                  {%- if block.settings.blurb != blank -%}
                    <span class="pd-box__curated-blurb">{{ block.settings.blurb }}</span>
                  {%- endif -%}
                  <span class="pd-box__curated-meta">{{ c_count }} cakes · ${{ c_price }}</span>
                </span>
                <span class="pd-box__curated-cta">Choose this box</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Steps 2–4 start folded (Moses, 2026-10-08: the full builder reads as too
      technical up front). Picking a size, choosing a curated box, or the arrow
      below opens them. `inert` keeps the folded controls out of the tab order.
    {%- endcomment -%}
    <button type="button" class="pd-box__expand" data-pd-expand aria-expanded="false" aria-controls="pd-box-more-{{ section.id }}">
      <span data-pd-expand-label>Choose your flavors</span>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </button>

    <div class="pd-box__more" id="pd-box-more-{{ section.id }}" data-pd-more inert>
    <div class="pd-box__more-in">

    {%- comment -%} Step 2 — flavors {%- endcomment -%}
    <div class="pd-box__step">
      <p class="pd-box__step-label"><span>2</span> Choose your flavors</p>
      <div class="pd-box__flavors">
        {%- for block in section.blocks -%}
          {%- if block.type == 'flavor' -%}
            {%- assign variant_id = block.settings.product.selected_or_first_available_variant.id -%}
            <div
              class="pd-box__flavor{% if block.settings.sold_out %} is-soldout{% endif %}"
              data-flavor="{{ block.id }}"
              data-name="{{ block.settings.name | escape }}"
              data-variant="{{ variant_id }}"
              data-soldout="{% if block.settings.sold_out %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- comment -%}
                Media only renders with a real photo now — an empty aspect-ratio:1 box
                (every placeholder flavor has no image yet) read as dead space and made
                cards uneven height next to the one that did have content (the sold-out
                swatch). Sold-out moves to a compact inline tag instead of a full block.
              {%- endcomment -%}
              {%- if block.settings.image != blank -%}
                <div class="pd-box__flavor-media">
                  {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160,320', alt: block.settings.name | escape }}
                </div>
              {%- endif -%}
              <div class="pd-box__flavor-info">
                <span class="pd-box__flavor-name">
                  {{ block.settings.name }}
                  {%- if block.settings.sold_out -%}<span class="pd-box__soldout-tag">Sold out</span>{%- endif -%}
                </span>
                {%- if block.settings.macro != blank -%}<span class="pd-box__flavor-macro">{{ block.settings.macro }}</span>{%- endif -%}
              </div>
              <div class="pd-box__stepper" data-stepper>
                <button type="button" class="pd-box__step-btn" data-minus aria-label="Remove one {{ block.settings.name | escape }}" disabled>&minus;</button>
                <span class="pd-box__qty" data-qty aria-live="polite">0</span>
                <button type="button" class="pd-box__step-btn" data-plus aria-label="Add one {{ block.settings.name | escape }}"{% if block.settings.sold_out %} disabled{% endif %}>+</button>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- comment -%} progress {%- endcomment -%}
      <div class="pd-box__tracker" data-pd-tracker>
        <div class="pd-box__count"><strong data-pd-selected>0</strong> of <strong data-pd-total>0</strong> selected</div>
        <div class="pd-box__bar"><span data-pd-bar style="width:0%"></span></div>
        <div class="pd-box__upsell" data-pd-upsell hidden></div>
      </div>
    </div>

    {%- comment -%}
      Step 3 — purchase options. Mirrors the PDP selector (prodani-subscribe.liquid) but
      writes into the builder's own state rather than a product form, because the box
      posts many line items at once and each needs the selling_plan attached.
    {%- endcomment -%}
    {%- if section.settings.sub_enabled -%}
      <div class="pd-box__step">
        <p class="pd-box__step-label"><span>3</span> One-time or subscribe</p>
        <fieldset class="pd-sub pd-sub--box" data-pd-box-sub>
          <legend class="pd-sub__legend visually-hidden">Purchase options</legend>

          <label class="pd-sub__opt">
            <input type="radio" name="pd-box-mode" value="onetime" checked data-pd-box-onetime>
            <span class="pd-sub__opt-main">
              <span class="pd-sub__opt-title">One-time purchase</span>
              <span class="pd-sub__opt-sub">Order once. No commitment.</span>
            </span>
          </label>

          <label class="pd-sub__opt pd-sub__opt--save{% unless has_plans %} is-preview{% endunless %}">
            <input type="radio" name="pd-box-mode" value="subscribe" data-pd-box-subscribe
                   {% unless has_plans %}disabled{% endunless %}>
            <span class="pd-sub__opt-main">
              <span class="pd-sub__opt-title">
                Subscribe &amp; save
                {%- if section.settings.sub_badge != blank -%}
                  <span class="pd-sub__badge">{{ section.settings.sub_badge }}</span>
                {%- endif -%}
              </span>
              <span class="pd-sub__opt-sub">{{ section.settings.sub_blurb }}</span>
            </span>
          </label>

          <div class="pd-sub__freq" data-pd-box-freq hidden>
            <label class="pd-sub__freq-label" for="pd-box-freq-{{ section.id }}">Deliver every</label>
            <select id="pd-box-freq-{{ section.id }}" class="pd-sub__select" data-pd-box-plan
                    {% unless has_plans %}disabled{% endunless %}>
              {%- if has_plans -%}
                {%- for plan in sub_group.selling_plans -%}
                  <option value="{{ plan.id }}">{{ plan.name }}</option>
                {%- endfor -%}
              {%- else -%}
                <option>Every 2 weeks</option>
                <option selected>Every 30 days</option>
                <option>Every 45 days</option>
              {%- endif -%}
            </select>
          </div>

          {%- unless has_plans -%}
            <p class="pd-sub__note">Preview: subscriptions activate once Shopify Subscriptions is set up and plans are attached to the {% if box_product != blank %}box product{% else %}flavor products{% endif %} (ticket T12).</p>
          {%- endunless -%}
        </fieldset>
      </div>
    {%- endif -%}

    {%- comment -%} Step 4 — validate + add {%- endcomment -%}
    <div class="pd-box__cta" data-pd-cta>
      <div class="pd-box__cta-price">
        <span class="pd-box__cta-total" data-pd-cta-total></span>
        <span class="pd-box__cta-per" data-pd-cta-per></span>
      </div>
      <button type="button" class="pd-box__add" data-pd-add disabled>Choose a box to start</button>
    </div>
    <p class="pd-box__note" data-pd-note role="status"></p>
    </div>
    </div>
  </div>
</section>

<script src="{{ 'prodani-box-builder.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Box builder",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "info": "Lets links target this section, e.g. /#box.", "default": "box" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build Your Box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your box" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick a size, mix your flavors, and choose one-time or subscribe." },
    { "type": "header", "content": "Build your own" },
    { "type": "text", "id": "build_tab_label", "label": "\"Build your own\" tab label", "default": "Build your own" },
    { "type": "text", "id": "sizes", "label": "Box sizes (comma-separated cake counts)", "default": "6,12,18" },
    { "type": "text", "id": "prices", "label": "Prices (comma-separated, same order)", "info": "Placeholders extrapolated from the launch price points — subject to the pricing check (T1) before launch.", "default": "49,89,120" },
    { "type": "range", "id": "default_size_index", "label": "Default size (1st/2nd/3rd)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "number", "id": "popular_count", "label": "\"Most Popular\" cake count", "default": 12 },
    { "type": "number", "id": "value_count", "label": "\"Best Value\" cake count", "default": 18 },
    { "type": "checkbox", "id": "upsell_enabled", "label": "Show upsell nudges", "default": true },
    { "type": "header", "content": "Curated boxes" },
    { "type": "text", "id": "curated_tab_label", "label": "\"Curated\" tab label", "default": "Curated boxes" },
    { "type": "product", "id": "box_product", "label": "Box product", "info": "One product with a variant per box size, titled \"6 cakes\", \"12 cakes\"… The whole box is added as one line at that variant's price, with the flavors listed on it." },
    { "type": "header", "content": "Subscriptions" },
    { "type": "checkbox", "id": "sub_enabled", "label": "Show one-time / subscribe step", "default": true },
    { "type": "text", "id": "sub_badge", "label": "Savings badge", "info": "Discount is set on the selling plan in the Shopify Subscriptions app — this is only the label.", "default": "Save 10%" },
    { "type": "text", "id": "sub_blurb", "label": "Subscribe blurb", "default": "Delivered on your schedule. Skip, pause, change or cancel anytime." }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "New flavor" },
        { "type": "text", "id": "macro", "label": "Macro label", "default": "20g protein" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "color", "id": "color", "label": "Chip accent", "default": "#C0A472" },
        { "type": "product", "id": "product", "label": "Linked product", "info": "Required for real add-to-cart and for subscription plans (T3)." },
        { "type": "checkbox", "id": "sold_out", "label": "Sold out", "info": "A sold-out flavor is skipped by curated boxes, so a curated mix that names one will under-fill and say so.", "default": false }
      ]
    },
    {
      "type": "curated",
      "name": "Curated box",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Best Sellers" },
        { "type": "text", "id": "blurb", "label": "Short description", "default": "Our most-ordered flavors, in one box." },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "number", "id": "size", "label": "Cake count", "default": 12 },
        { "type": "number", "id": "price", "label": "Price", "info": "Subject to the pricing check (T1).", "default": 89 },
        { "type": "text", "id": "mix", "label": "Flavor mix", "info": "Format: \"Chocolate Fudge:4, Vanilla Bean:4, Strawberry:4\". Leave blank for an even spread across every in-stock flavor (a Variety box)." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Box builder",
      "blocks": [
        { "type": "flavor", "settings": { "name": "Chocolate Fudge", "macro": "21g protein · 180 cal", "color": "#211913" } },
        { "type": "flavor", "settings": { "name": "Vanilla Bean", "macro": "20g protein · 170 cal", "color": "#EFEAE0" } },
        { "type": "flavor", "settings": { "name": "Strawberry", "macro": "19g protein · 175 cal", "color": "#C0A472" } },
        { "type": "flavor", "settings": { "name": "Cookie Butter", "macro": "20g protein · 190 cal", "color": "#7E6537" } },
        { "type": "flavor", "settings": { "name": "Matcha", "macro": "20g protein · 165 cal", "color": "#67654A" } },
        { "type": "flavor", "settings": { "name": "Salted Caramel", "macro": "21g protein · 185 cal", "color": "#3A2E24" } },
        { "type": "curated", "settings": { "name": "Best Sellers", "blurb": "Our most-ordered flavors, in one box.", "badge": "Most Popular", "size": 12, "price": 89, "mix": "Chocolate Fudge:4, Cookie Butter:4, Salted Caramel:4" } },
        { "type": "curated", "settings": { "name": "Variety Box", "blurb": "A little of everything — the easiest way to find your favourite.", "size": 12, "price": 89, "mix": "" } }
      ]
    }
  ]
}
{% endschema %}
