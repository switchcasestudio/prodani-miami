{%- comment -%}
  Reviews. The aggregate and each quote are editable settings so real Judge.me
  reviews can be pasted in — nothing here is generated. Turn on "Use the Judge.me
  widget" to render the live widget beneath instead, once its app embed is enabled.
{%- endcomment -%}

{{ 'prodani-reviews.css' | asset_url | stylesheet_tag }}

<section class="pd-reviews{% if section.settings.lead == 'rating' %} pd-reviews--rating{% endif %}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="pd-wrap">
    {%- comment -%}
      The count IS the headline (Moses 2026-10-11: "132 is a lot, it doesn't feel like it").
      When the heading starts with a number it splits into a giant numeral plus the rest.
      Count and rating come from Judge.me's own aggregate (the all-reviews header it
      writes to the shop metafields), so they stay true as reviews arrive. The heading's
      number is only the fallback, and there are no stars unless Judge.me has a rating.
    {%- endcomment -%}
    {%- liquid
      assign heading = section.settings.heading | strip
      assign lead = heading | split: ' ' | first
      assign lead_num = lead | plus: 0
      assign lead_str = lead_num | append: ''
      assign jm = shop.metafields.judgeme.all_reviews_header | append: ''
      assign jm_count = ''
      assign jm_rating = ''
      if jm contains "data-number-of-reviews='"
        assign jm_count = jm | split: "data-number-of-reviews='" | last | split: "'" | first
      endif
      if jm contains "data-average-rating='"
        assign jm_rating = jm | split: "data-average-rating='" | last | split: "'" | first
      endif
      if jm_count == '0'
        assign jm_count = ''
      endif
    -%}
    {%- if lead_str == lead and lead_num > 0 -%}
      {%- liquid
        assign big = jm_count | default: lead
        assign label = heading | remove_first: lead | strip
        if jm_rating != ''
          assign rating = jm_rating | times: 1.0 | round: 1
          assign rating_pct = jm_rating | times: 20.0
        endif
      -%}
      <div class="pd-reviews__head">
        <h2 class="visually-hidden">{{ big }} {{ label | escape }}{% if rating %}, rated {{ rating }} out of 5{% endif %}</h2>
        {%- comment -%} Macro Bold audit (2026-11-10): the average rating can lead instead of the count. {%- endcomment -%}
        {%- if section.settings.lead == 'rating' and rating -%}
        <div class="pd-reviews__hero" aria-hidden="true">
          <span class="pd-reviews__count">{{ rating }}</span>
          <span class="pd-reviews__side">
            <span class="pd-reviews__stars"><span style="width:{{ rating_pct }}%">★★★★★</span>★★★★★</span>
          </span>
        </div>
        <p class="pd-reviews__sub"><b>{{ big }}</b> {{ label | escape }}{% if section.settings.eyebrow != blank %} · {{ section.settings.eyebrow | escape }}{% endif %}</p>
        {%- else -%}
        <div class="pd-reviews__hero" aria-hidden="true">
          <span class="pd-reviews__count">{{ big }}</span>
          <span class="pd-reviews__side">
            {%- if rating -%}
              <span class="pd-reviews__stars"><span style="width:{{ rating_pct }}%">★★★★★</span>★★★★★</span>
            {%- endif -%}
            <span class="pd-reviews__label">{{ label | escape }}</span>
          </span>
        </div>
        <p class="pd-reviews__sub">
          {%- if rating -%}<b>{{ rating }}</b> out of 5{%- if section.settings.eyebrow != blank %} · {% endif -%}{%- endif -%}
          {{ section.settings.eyebrow | escape }}
        </p>
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="pd-sec-head">
        <div>
          <h2 class="pd-sec-title">{{ heading | escape }}</h2>
          {% render 'prodani-squiggle' %}
        </div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="pd-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pd-reviews__grid">
        {%- for block in section.blocks -%}
          <figure class="pd-review" {{ block.shopify_attributes }}>
            <span class="pd-review__stars" aria-label="{{ block.settings.rating }} out of 5">
              {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
            </span>
            {%- if block.settings.title != blank -%}
              <h3 class="pd-review__title">&ldquo;{{ block.settings.title | escape }}&rdquo;</h3>
            {%- endif -%}
            <blockquote class="pd-review__body">{{ block.settings.body | escape }}</blockquote>
            <figcaption class="pd-review__who">
              <span class="pd-review__avatar" aria-hidden="true">{{ block.settings.author | slice: 0 | upcase }}</span>
              <span>
                <b>{{ block.settings.author | escape }}</b>
                <i>{{ block.settings.note | default: 'Verified buyer' | escape }}</i>
              </span>
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_widget -%}
      {%- comment -%}
        Judge.me's all-reviews widget renders from shop.metafields.judgeme.*, which
        is server-side, so the full list is present even before their app-embed JS
        loads. The embed only adds styling and the star webfont.
      {%- endcomment -%}
      {%- comment -%} Moses 2026-11-18: unfolding all 133 reviews in place made the page
          endless ("one big MESS"). The full list now opens in a side panel with its own
          scroll; the page keeps its length. Esc, the close button or the backdrop shut it. {%- endcomment -%}
      <div class="pd-reviews__more">
        <button type="button" class="pd-btn pd-btn--outline" data-pd-reviews-open aria-haspopup="dialog" aria-controls="pd-reviews-panel">
          {{ section.settings.more_label | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
        {%- comment -%} Tweaks 8 (Moses 2026-11-19: "add a button 'add a review'"): opens the same
            panel with Judge.me's review form already open. {%- endcomment -%}
        {%- if section.settings.write_label != blank -%}
          <button type="button" class="pd-btn pd-btn--ghost pd-reviews__write" data-pd-reviews-write aria-haspopup="dialog" aria-controls="pd-reviews-panel">{{ section.settings.write_label | escape }}</button>
        {%- endif -%}
      </div>
      <dialog class="pd-reviews__panel" id="pd-reviews-panel" aria-labelledby="pd-reviews-panel-title">
        <div class="pd-reviews__panel-head">
          <p class="pd-reviews__panel-title" id="pd-reviews-panel-title">{%- if big != blank -%}{{ big }} {{ label | escape }}{%- else -%}{{ heading | escape }}{%- endif -%}</p>
          <button type="button" class="pd-reviews__panel-close" data-pd-reviews-close aria-label="Close reviews">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="pd-reviews__widget" id="judgeme_all_reviews_page">
          {% render 'judgeme_all_reviews' %}
        </div>
      </dialog>
      <script>
        (function(){
          var d=document.getElementById('pd-reviews-panel'), o=document.querySelector('[data-pd-reviews-open]');
          if(!d||!o||!d.showModal) return;
          o.addEventListener('click',function(){ d.showModal(); });
          var w=document.querySelector('[data-pd-reviews-write]');
          // Judge.me binds its form toggle once the widget has been on screen, so wait for the
          // link to be live (up to ~2.5s), then open the form and bring it into view.
          if(w) w.addEventListener('click',function(){
            d.showModal();
            var tries=0;
            (function openForm(){
              var l=d.querySelector('.jdgm-write-rev-link'), f=d.querySelector('.jdgm-form-wrapper');
              if(f && f.offsetParent){ f.scrollIntoView({block:'start'}); return; }
              if(l && l.offsetParent && tries>2) l.click();
              if(++tries<12) setTimeout(openForm,220);
            })();
          });
          d.querySelector('[data-pd-reviews-close]').addEventListener('click',function(){ d.close(); });
          d.addEventListener('click',function(e){ if(e.target===d) d.close(); });
        })();
      </script>
    {%- endif -%}

    {%- comment -%} 2026-09-01: the "Shop the collection" CTA was removed on
        request (all viewports) — this section keeps a single action, the
        Read-all-reviews toggle above. {%- endcomment -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "select", "id": "lead", "label": "Big number", "options": [ { "value": "count", "label": "Review count" }, { "value": "rating", "label": "Average rating (quotes beside it)" } ], "default": "count" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verified · Judge.me" },
    {
      "type": "checkbox", "id": "show_widget", "label": "Also show the live Judge.me list",
      "info": "Renders the full Judge.me list inside a More reviews panel.", "default": true
    },
    { "type": "text", "id": "more_label", "label": "Expand label", "default": "Read all reviews" },
    { "type": "text", "id": "write_label", "label": "Write-a-review button", "info": "Opens the reviews panel with the review form. Leave empty to hide.", "default": "Write a review" },
    { "type": "text", "id": "less_label", "label": "Collapse label", "default": "Show fewer" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "author", "label": "Name" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Headline" },
        { "type": "textarea", "id": "body", "label": "Review" },
        { "type": "text", "id": "note", "label": "Caption under the name", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
