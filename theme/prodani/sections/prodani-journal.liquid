{%- comment -%}
  Journal — the blog index, in the v2 vocabulary. Lead story on top, the rest
  in a three-up grid. The Shopify blog is still called "News" (its handle is
  the URL, so renaming it would break published links); the heading shown is a
  section setting so the page can read "Journal" without touching the blog.
{%- endcomment -%}

{{ 'prodani-journal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading | default: blog.title
  assign per_page = section.settings.per_page | default: 7
-%}

{%- paginate blog.articles by per_page -%}
<section class="pd-journal">
  <div class="pd-wrap">
    <div class="pd-sec-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="pd-eyebrow" style="margin:0 0 10px">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="pd-sec-title">{{ heading | escape }}</h1>
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="pd-lede pd-journal__lede" style="margin:0">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
    </div>

    {%- if blog.articles.size == 0 -%}
      <p class="pd-journal__empty">{{ section.settings.empty_text | escape }}</p>
    {%- endif -%}

    {%- liquid
      assign lead_on = false
      if paginate.current_page == 1 and blog.articles.size > 0
        assign lead_on = true
      endif
    -%}

    {%- if lead_on -%}
      {%- liquid
        assign article = blog.articles.first
        assign words = article.content | strip_html | split: ' ' | size
        assign minutes = words | divided_by: 200.0 | ceil
        if minutes < 1
          assign minutes = 1
        endif
        if article.excerpt != blank
          assign excerpt = article.excerpt | strip_html | truncatewords: 34
        else
          assign excerpt = article.content | strip_html | truncatewords: 34
        endif
      -%}
      <article class="pd-journal__lead">
        {%- if article.image -%}
          <a class="pd-bezel pd-journal__media" href="{{ article.url }}" aria-hidden="true" tabindex="-1">
            <img
              src="{{ article.image | image_url: width: 1200 }}"
              srcset="{{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 1200 }} 1200w, {{ article.image | image_url: width: 1800 }} 1800w"
              sizes="(min-width: 981px) 58vw, 100vw"
              width="{{ article.image.width }}" height="{{ article.image.height }}"
              alt="{{ article.image.alt | escape }}" loading="eager" fetchpriority="high">
          </a>
        {%- endif -%}
        <div class="pd-journal__lead-copy">
          <p class="pd-journal__meta">
            {%- if section.settings.show_date -%}<span>{{ article.published_at | date: '%b %-d, %Y' }}</span>{%- endif -%}
            <span>{{ minutes }} min read</span>
            {%- if section.settings.show_author and article.author != blank -%}<span>{{ article.author | escape }}</span>{%- endif -%}
          </p>
          <h2 class="pd-journal__lead-title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
          {%- if excerpt != blank -%}<p class="pd-journal__excerpt">{{ excerpt }}</p>{%- endif -%}
          <a class="pd-journal__read" href="{{ article.url }}">
            {{ section.settings.read_label | default: 'Read the post' | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </article>
    {%- endif -%}

    {%- if blog.articles.size > 1 or lead_on == false -%}
      <div class="pd-journal__grid">
        {%- for article in blog.articles -%}
          {%- if lead_on and forloop.first -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign words = article.content | strip_html | split: ' ' | size
            assign minutes = words | divided_by: 200.0 | ceil
            if minutes < 1
              assign minutes = 1
            endif
            if article.excerpt != blank
              assign excerpt = article.excerpt | strip_html | truncatewords: 22
            else
              assign excerpt = article.content | strip_html | truncatewords: 22
            endif
          -%}
          <article class="pd-journal__card">
            {%- if article.image -%}
              <a class="pd-bezel pd-journal__media" href="{{ article.url }}" aria-hidden="true" tabindex="-1">
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 981px) 31vw, (min-width: 621px) 48vw, 100vw"
                  width="{{ article.image.width }}" height="{{ article.image.height }}"
                  alt="{{ article.image.alt | escape }}" loading="lazy">
              </a>
            {%- endif -%}
            <p class="pd-journal__meta">
              {%- if section.settings.show_date -%}<span>{{ article.published_at | date: '%b %-d, %Y' }}</span>{%- endif -%}
              <span>{{ minutes }} min read</span>
            </p>
            <h2 class="pd-journal__card-title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            {%- if excerpt != blank -%}<p class="pd-journal__excerpt">{{ excerpt }}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Journal (blog index)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ProDani Journal" },
    { "type": "text", "id": "heading", "label": "Heading (blank = blog title)", "default": "Journal" },
    { "type": "text", "id": "lede", "label": "Lede", "default": "Notes from the bakery on protein, ingredients and how we bake." },
    { "type": "text", "id": "read_label", "label": "Read link label", "default": "Read the post" },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "First post coming soon." },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author on lead story", "default": true },
    { "type": "range", "id": "per_page", "label": "Posts per page", "min": 4, "max": 13, "step": 3, "default": 7 }
  ]
}
{% endschema %}
