{%- comment -%}
  Product benefit strip. The icon art is the store's own (sliced out of the brand
  strip on their CDN); the labels are real text rather than the baked-in pixels
  from that strip, so they scale, translate, and reflow instead of turning into a
  six-across smudge on a phone.
{%- endcomment -%}

{{ 'prodani-badges.css' | asset_url | stylesheet_tag }}

<section class="pd-badges{% if section.settings.bottom_marquee %} pd-badges--wave-bottom{% endif %}" style="--pd-badges-bg:{{ section.settings.background }};">
  <div class="pd-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="pd-badges__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- comment -%} --wave lays the icons along the same wave the marquees ride (desktop
       only; the grid stays flat once it wraps on tablet/phone). {%- endcomment -%}
    <ul class="pd-badges__row{% if section.settings.wave_icons %} pd-badges__row--wave{% endif %}">
      {%- for block in section.blocks -%}
        <li class="pd-badge-item" {{ block.shopify_attributes }}>
          {%- comment -%} The icon slices are cocoa circles clipped at the bottom edge. The
             disc is a cocoa circle behind them (exact colour match, #362619) that completes
             the round shape; object-fit:contain keeps the whole symbol visible, never cut. {%- endcomment -%}
          <span class="pd-badge-item__disc">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 320
                 | image_tag: loading: 'lazy', alt: '', class: 'pd-badge-item__icon' }}
            {%- else -%}
              <img class="pd-badge-item__icon"
                   src="{{ block.settings.icon | append: '.png' | asset_url }}"
                   alt="" loading="lazy" width="340" height="245">
            {%- endif -%}
          </span>
          {%- if block.settings.icon contains 'prodani-icon-' and block.settings.image == blank -%}
            {%- comment -%} 2026 line icons: inlined so stroke="currentColor" takes the text colour. {%- endcomment -%}
            <span class="pd-badge-item__line" aria-hidden="true">{{ block.settings.icon | append: '.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="pd-badge-item__label">{{ block.settings.label | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- comment -%} Bottom wave marquee — mirrors the hero's top one, closing the pink band
     with a wave into the cream section below. {%- endcomment -%}
  {%- if section.settings.bottom_marquee and section.settings.marquee_items != blank -%}
    {% render 'prodani-marquee',
       items: section.settings.marquee_items,
       speed: section.settings.marquee_speed,
       fill_below: 'var(--cream)',
       modifier: 'pd-marquee--badges' %}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Benefit badges",
  "tag": "section",
  "class": "pd-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "color", "id": "background", "label": "Background", "default": "#E0A458" },
    { "type": "checkbox", "id": "wave_icons", "label": "Lay icons along a wave (desktop)", "default": true },
    { "type": "header", "content": "Bottom marquee" },
    { "type": "checkbox", "id": "bottom_marquee", "label": "Show bottom wave marquee", "default": false },
    { "type": "text", "id": "marquee_items", "label": "Marquee items (comma-separated)", "default": "high protein, no sugar added, gluten free, small batch, miami made" },
    { "type": "range", "id": "marquee_speed", "label": "Marquee speed", "min": 10, "max": 60, "step": 2, "default": 26 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        {
          "type": "select", "id": "icon", "label": "Bundled icon",
          "options": [
            { "value": "prodani-icon-protein",          "label": "Line: Protein" },
            { "value": "prodani-icon-no-added-sugar",   "label": "Line: No added sugar" },
            { "value": "prodani-icon-gluten-free",      "label": "Line: Gluten free" },
            { "value": "prodani-icon-small-batch",      "label": "Line: Small batch" },
            { "value": "prodani-icon-baked-in-miami",   "label": "Line: Baked in Miami" },
            { "value": "prodani-icon-verified-reviews", "label": "Line: Verified reviews" },
            { "value": "prodani-icon-subscribe",        "label": "Line: Subscribe" },
            { "value": "prodani-icon-build-your-box",   "label": "Line: Build your box" },
            { "value": "prodani-badge-high-protein",  "label": "High protein" },
            { "value": "prodani-badge-non-gmo",       "label": "Non GMO" },
            { "value": "prodani-badge-no-sugar-added","label": "No sugar added" },
            { "value": "prodani-badge-gluten-free",   "label": "Gluten free" },
            { "value": "prodani-badge-high-fiber",    "label": "High fiber" },
            { "value": "prodani-badge-low-calorie",   "label": "Low calorie" }
          ],
          "default": "prodani-badge-high-protein"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon (overrides the bundled one)" }
      ]
    }
  ],
  "presets": [{ "name": "Benefit badges" }]
}
{% endschema %}
